# Lead capture destination for the "Reserve capacity" bar and the contact form.
# Any endpoint that accepts a POST of { email, message?, source } will do.
# [PLACEHOLDER] Not yet chosen — see README "Integration map".
PUBLIC_RESERVE_ENDPOINT=

# Analytics. Left empty means no script is loaded at all.
# [PLACEHOLDER] Not yet chosen.
PUBLIC_ANALYTICS_ID=

# Canonical origin, used for canonical tags, Open Graph URLs and the sitemap.
PUBLIC_SITE_ORIGIN=https://smarttec.z1power.com

# ---------------------------------------------------------------------------
# Investor room (/investors). Server-only — never give these a PUBLIC_ prefix,
# they must not reach the browser. Generate them with `npm run setup` in the
# investor module package, then set them in Vercel's environment settings.
# ---------------------------------------------------------------------------

# Exact origin, no trailing slash. The login route rejects any other origin,
# so a mismatch here reads as "the password is wrong".
INVESTOR_ORIGIN=https://www.smarttec.dev

# Salted scrypt hash of the access password, and a separate random signing
# secret for session references. Rotating either invalidates live sessions.
# [PLACEHOLDER] Generated by the module's setup script.
INVESTOR_PASSWORD_HASH=
INVESTOR_SESSION_SECRET=

# Upstash Redis, over its REST interface — sessions and rate-limit counters.
# Must be a durable database, not a demo one: losing it logs everybody out.
# [PLACEHOLDER] Not yet provisioned.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Loopback HTTP for local tests only. Forced off on Vercel regardless.
INVESTOR_LOCAL_HTTP=0

# Satellite imagery on the campus map. Restrict the key to the production
# domain in MapTiler. Without it the map runs as a concept plan.
# [PLACEHOLDER] Not yet chosen.
INVESTOR_MAPTILER_KEY=
