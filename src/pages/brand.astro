---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import kit from '../data/brand-kit.json';
import {BRAND_ROOT as B, formatSize, categories, files, visuals, marks, variants, palette} from '../data/brand-library';
import '../styles/brand-library.css';
const primary=files.filter(f=>f.path.startsWith('logos/') && f.path.includes('smarttec-lockup-offwhite-green') && !f.path.includes('1200'));
---

<Base noindex title="Brand studio | SmartTec by Z1Power" description="Explore the SmartTec identity. Preview every logo, social image, animation and embroidery design, choose a variant, and download the right file.">
  <SiteHeader />
  <main id="main" class="brand-studio">
    <header class="brand-hero" id="all">
      <div class="brand-hero__copy">
        <p class="brand-eyebrow"><span></span> SmartTec / Brand studio</p>
        <h1>One identity.<br /><em>Every expression.</em></h1>
        <p class="brand-hero__intro">The marks, the motion, the details. Everything we created for SmartTec, ready for its next use.</p>
        <div class="brand-actions">
          <a class="brand-button" href="#library">Explore the library <span aria-hidden="true">↓</span></a>
          <a class="brand-button brand-button--quiet" href={`${B}/smarttec-brand-kit.zip`} download>Download full kit <span aria-hidden="true">↗</span></a>
        </div>
        <p class="brand-fine">{kit.fileCount} original files · {formatSize(kit.zipBytes)} · All in one ZIP</p>
      </div>
      <div class="brand-hero__art">
        <div class="brand-orbit" aria-hidden="true"></div>
        <div class="brand-hero__screen">
          <div class="brand-screen-label"><span class="brand-dot"></span> Identity in motion <span>01 / 12 SEC</span></div>
          <video id="brand-hero-video" muted loop playsinline preload="none" poster={`${B}/animated/smarttec-energy-poster-1920x1080.jpg`} aria-label="SmartTec energy loop preview">
            <source src={`${B}/animated/smarttec-energy-loop-1920x1080.mp4`} type="video/mp4" />
          </video>
          <div class="brand-screen-foot"><span>Designed to carry the signal.</span><button type="button" data-hero-play aria-pressed="false" hidden>Play motion <span aria-hidden="true">▷</span></button></div>
        </div>
        <p class="brand-art-caption">THE ARCHITECTURAL S / THE GREEN CORE / BY Z1POWER</p>
      </div>
    </header>

    <nav class="brand-jumps" aria-label="Brand studio sections">
      <a href="#marks"><span>01</span> Logo studio</a><a href="#library"><span>02</span> Asset library</a><a href="#palette"><span>03</span> Colours</a><a href="#rules"><span>04</span> Usage & handoff</a>
      <a class="brand-jumps__download" href={`${B}/smarttec-brand-kit.zip`} download>Full kit <span aria-hidden="true">↓</span></a>
    </nav>

    <section class="brand-section" aria-labelledby="marks" data-logo-studio>
      <div class="brand-section-head"><div><p class="brand-eyebrow">01 / Choose your mark</p><h2 id="marks">The right logo.<br />For the right setting.</h2></div><p>Try a mark and colour combination. The preview and downloads stay together, so you always get the version you see.</p></div>
      <div class="logo-workbench">
        <div class="logo-workbench__preview" data-logo-surface="dark">
          <span class="brand-corner-label" data-logo-label>Full logo / Off-white + green</span>
          <img data-logo-image src={`${B}/logos/svg/smarttec-lockup-offwhite-green.svg`} alt="SmartTec full logo, off-white and green" width="1231" height="298" />
          <span class="logo-workbench__ground" data-logo-ground>Preview on forest</span>
        </div>
        <div class="logo-workbench__settings">
          <fieldset><legend>01 / Mark</legend><div class="brand-segmented">{marks.map((mark,i)=><label><input type="radio" name="brand-mark" value={mark.id} checked={i===0}/><span>{mark.name}</span></label>)}</div></fieldset>
          <fieldset><legend>02 / Colour</legend><div class="logo-variants">{variants.map((variant,i)=><label><input type="radio" name="brand-variant" value={variant.id} checked={i===0}/><span class="logo-variant-dot" style={`--swatch:${variant.colour}`}></span><span>{variant.name}</span></label>)}</div></fieldset>
          <p class="brand-note" data-logo-note>{marks[0].note}</p>
          <div class="logo-downloads" data-logo-downloads>{primary.map(f=><a href={f.url} download><b>{f.format}</b><span>{f.format==='PNG'?'2400 px · transparent':f.format==='SVG'?'Web & scalable design':'Print & signage'}</span><span aria-hidden="true">↓</span></a>)}</div>
          <p class="brand-fine">SVG for web. PNG for slides. EPS for your printer.</p>
          <noscript><p>The selector needs JavaScript. Every version is also shown in the library below.</p></noscript>
        </div>
      </div>
    </section>

    <section class="brand-section brand-library" aria-labelledby="library">
      <div class="brand-section-head"><div><p class="brand-eyebrow">02 / The complete collection</p><h2 id="library">See it. Find it.<br /><em>Make something.</em></h2></div><p>All {visuals.length} image and motion files, with a preview for every one. Open any design to see it larger and download the original.</p></div>
      <div class="brand-library-tools" data-library-tools hidden>
        <div class="brand-search-row"><label class="brand-search"><span aria-hidden="true">⌕</span><input type="search" id="brand-search" placeholder="Search logos, stories, embroidery…" aria-label="Search brand assets" autocomplete="off" /></label><label class="brand-format">Format<select id="brand-format"><option value="all">All formats</option>{[...new Set(visuals.map(v=>v.format))].sort().map(format=><option value={format}>{format}</option>)}</select></label></div>
        <div class="brand-filter-row"><div class="brand-filters" role="group" aria-label="Filter by category">{categories.map(category=><button type="button" data-brand-category={category.id} aria-pressed={category.id==='all'}>{category.label}<span>{category.id==='all'?visuals.length:visuals.filter(v=>v.category===category.id).length}</span></button>)}</div><button type="button" class="brand-reset" data-library-reset>Reset filters ↺</button></div>
      </div>
      <div class="brand-library-caption"><p role="status" aria-live="polite" data-library-count>{visuals.length} previews</p><span>Original artwork / Ready to explore</span></div>
      <div class="brand-empty" data-library-empty hidden><h3>No matching designs.</h3><p>Try a broader search or clear the filters.</p><button class="brand-button" type="button" data-library-reset>Show all assets</button></div>
      <div class="brand-asset-grid">
        {visuals.map((asset,index)=><article class="brand-asset" data-brand-asset data-asset-index={index} data-category={asset.category} data-format={asset.format} data-search={`${asset.title} ${asset.path} ${asset.category}`.toLowerCase()}>
          <a class="brand-asset__preview" href={asset.url} data-open-preview={index} data-surface={asset.surface} aria-label={`Preview ${asset.title}, ${asset.format}`}>
            <img src={asset.kind==='image'?asset.url:asset.poster} alt={asset.title} loading="lazy" decoding="async" width="640" height="420" />
            <span class="brand-asset__format">{asset.format}</span><span class="brand-asset__expand" aria-hidden="true">{asset.kind==='image'?'↗':'▷'}</span>
            {asset.kind!=='image'&&<span class="brand-asset__motion">{asset.kind==='gif'?'Animated GIF':'Play preview'}</span>}
          </a>
          <div class="brand-asset__info"><h3>{asset.title}</h3><p>{asset.path.includes('embroidery-pes')?'Test sew-out · ':''}{asset.size} <span>· {asset.format}</span></p><a href={asset.url} download aria-label={`Download ${asset.title}, ${asset.format}`}>Download <span aria-hidden="true">↓</span></a></div>
        </article>)}
      </div>
      <noscript><p class="brand-note">All previews and downloads are available below. Enable JavaScript for search, filters and the full-screen viewer.</p></noscript>
      <details class="brand-file-index" id="index">
        <summary><span>Need a source file or stitch program?</span><span>Browse all {files.length} files <span aria-hidden="true">↗</span></span></summary>
        <div class="brand-file-index__body"><label class="brand-search" data-file-search-label hidden><input id="brand-file-search" type="search" placeholder="Find a filename, format or folder…" aria-label="Search all original files" /></label><p data-file-count role="status">{files.length} files</p><ul>{files.map(file=><li data-file-row data-search={`${file.path} ${file.title}`.toLowerCase()}><a href={file.url} download><span>{file.path}</span><span>{file.format} · {file.size} ↓</span></a></li>)}</ul></div>
      </details>
    </section>

    <section class="brand-section" aria-labelledby="palette">
      <div class="brand-section-head"><div><p class="brand-eyebrow">03 / The signature palette</p><h2 id="palette">Four colours.<br />One clear signal.</h2></div><p>Forest sets the scene. Green brings the energy. Off-white gives it space. Click a colour to copy its hex code.</p></div>
      <div class="brand-palette">{palette.map(colour=><button type="button" data-copy-colour={colour.hex} aria-label={`Copy ${colour.name} ${colour.hex}`} style={`--swatch:${colour.hex}`}><span class="brand-palette__swatch"><span aria-hidden="true">↗</span></span><span class="brand-palette__name">{colour.name}<b data-colour-hex>{colour.hex}</b></span><span class="brand-palette__use">{colour.use}</span></button>)}</div>
      <p class="brand-copy-status" data-copy-status role="status" aria-live="polite"></p>
    </section>

    <section class="brand-section" aria-labelledby="rules">
      <div class="brand-section-head"><div><p class="brand-eyebrow">04 / A little guidance</p><h2 id="rules">Keep the identity intact.</h2></div><p>A few simple rules, and the files your collaborators need.</p></div>
      <div class="brand-guides">
        <article><span class="brand-guide-number">01</span><h3>Give it room.</h3><p>Keep the proportions locked and leave at least the height of the green core around the mark. Use the wordmark if the endorsement becomes too small.</p></article>
        <article><span class="brand-guide-number">02</span><h3>Keep the mark flat.</h3><p>Choose a supplied colour version with clear contrast. Keep shadows, glows and gradients off the letterforms. The movement belongs to the particles.</p></article>
        <article id="apparel"><span class="brand-guide-number">03</span><h3>Sample before stitching.</h3><p>PES files are test sew-out drafts, not approved production masters. Ask your shop to test the chosen size on the actual fabric. Do not resize stitch data.</p><a href={`${B}/embroidery-pes/refined-satin/READ-ME-FIRST.md`}>Embroidery handoff ↗</a></article>
      </div>
      <div class="brand-handoff" id="dev"><div><p class="brand-eyebrow">Ready for the next project</p><h3>Good work starts with the originals.</h3><p>Download the complete kit, or pass the designer notes to your team.</p></div><div class="brand-actions"><a class="brand-button" href={`${B}/smarttec-brand-kit.zip`} download>Get the full kit · {formatSize(kit.zipBytes)} ↓</a><a class="brand-button brand-button--quiet" href={`${B}/README-DESIGNER.md`}>Designer notes ↗</a><a class="brand-text-link" href={`${B}/previews/approved-particle-preview.html`}>Open interactive particle demo ↗</a></div></div>
      <p class="brand-fine">A shared brand resource. Unlisted, but accessible to anyone with this link.</p>
    </section>
  </main>
  <SiteFooter />

  <dialog class="brand-viewer" id="brand-viewer" aria-labelledby="brand-viewer-title">
    <div class="brand-viewer__top"><p class="brand-eyebrow">SmartTec / Preview studio</p><button type="button" data-viewer-close aria-label="Close preview">Close <span aria-hidden="true">×</span></button></div>
    <div class="brand-viewer__stage" data-viewer-stage data-surface="dark"></div>
    <div class="brand-viewer__bottom"><div class="brand-viewer__details"><h2 id="brand-viewer-title"></h2><p data-viewer-note></p><p class="brand-fine" data-viewer-file></p></div><div class="brand-viewer__actions"><a class="brand-button" data-viewer-download download>Download original ↓</a><span data-viewer-related></span></div></div>
    <div class="brand-viewer__controls"><button type="button" data-viewer-prev aria-label="Previous asset">← Previous</button><p data-viewer-position aria-live="polite"></p><label>Background<select data-viewer-background aria-label="Preview background"><option value="auto">Automatic</option><option value="dark">Forest</option><option value="light">Off-white</option><option value="checker">Transparency grid</option></select></label><button type="button" data-viewer-next aria-label="Next asset">Next →</button></div>
  </dialog>
  <script>
    import {initBrandLibrary} from '../lib/brand-library';
    initBrandLibrary();
  </script>
</Base>
