---
import Content from '../layouts/Content.astro';
import { company, site, power, compute } from '../data/site';

/* Split so the headline figure and its qualifier can be set at different sizes
   without either being retyped away from the site record. */

---

<Content
  title={`Reserve capacity at ${site.designation} | ${company.full}`}
  description={`Talk to ${company.full} about dedicated compute or customer-owned hosting at ${site.name}. A submission is an inquiry — it starts a deployment review, and does not reserve capacity.`}
  kicker="Contact"
  heading="Let’s plan your workload."
  lede={`The planned first phase is ${compute.servers} servers and ${compute.gpus} GPUs. Tell us the workload and the date you need it, and you will get a review of what the facility can actually take — not a reservation, and not a number we cannot stand behind.`}
  meta={[
    { label: 'Planned GPUs', value: String(compute.gpus), note: compute.systems, tone: 'signal', count: true },
    { label: 'Power-on target', value: site.powerOn, note: 'Phase 1A compute hall' },
    { label: 'Shared service', value: power.service, note: 'Buildings A, B and C', tone: 'gold' },
    { label: 'Allocation', value: 'On review', note: power.allocation },
  ]}
>
  <section aria-labelledby="form-heading" data-reveal>
    <p class="eyebrow" aria-hidden="true"><span class="eyebrow__n">01</span><span class="eyebrow__t">Tell us what you need</span></p>
    <h2 id="form-heading">Request a deployment review</h2>

    <p class="form-note">
      This is an inquiry. Sending it does not reserve inventory, commit capacity or
      fix a price — it starts a conversation in which we confirm workload
      suitability, equipment availability, facility allocation and commercial terms.
      <span class="todo">[PLACEHOLDER: inquiry destination — set PUBLIC_RESERVE_ENDPOINT to the CRM or mail relay before launch. Until it is set this form will tell visitors it cannot deliver rather than pretend it has.]</span>
    </p>

    <form class="form" id="reserve-enquiry" method="post" action="/api/reserve">
      <fieldset class="form__set">
        <legend class="form__legend"><span class="form__legend-n">01</span>You</legend>

        <div class="form__grid">
          <p class="field">
            <label class="field__label" for="name">Full name <span class="field__req" aria-hidden="true">*</span></label>
            <input class="field__input" id="name" name="name" type="text" autocomplete="name" required />
          </p>

          <p class="field">
            <label class="field__label" for="org">Company <span class="field__req" aria-hidden="true">*</span></label>
            <input class="field__input" id="org" name="company" type="text" autocomplete="organization" required />
          </p>

          <p class="field">
            <label class="field__label" for="email">Work email <span class="field__req" aria-hidden="true">*</span></label>
            <input
              class="field__input"
              id="email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              aria-describedby="email-hint"
              required
            />
            <span class="field__hint" id="email-hint">We reply from a person, not a sequence.</span>
          </p>

          <p class="field">
            <label class="field__label" for="phone">Phone</label>
            <input class="field__input" id="phone" name="phone" type="tel" autocomplete="tel" />
          </p>
        </div>
      </fieldset>

      <fieldset class="form__set">
        <legend class="form__legend"><span class="form__legend-n">02</span>The deployment</legend>

        <div class="form__grid">
          <p class="field">
            <label class="field__label" for="offering">What you are looking for <span class="field__req" aria-hidden="true">*</span></label>
            <select class="field__input" id="offering" name="offering" required>
              <option value="">Choose one</option>
              <option value="dedicated">Dedicated compute — I use your GPUs</option>
              <option value="hosting">Customer-owned hosting — I bring the hardware</option>
              <option value="expansion">A larger future deployment</option>
              <option value="unsure">Not sure yet</option>
            </select>
          </p>

          <p class="field">
            <label class="field__label" for="load">Load required, in kW</label>
            <input
              class="field__input"
              id="load"
              name="load_kw"
              type="number"
              min="1"
              step="1"
              inputmode="numeric"
              aria-describedby="load-hint"
              placeholder="Leave blank if not yet known"
            />
            <span class="field__hint" id="load-hint">
              IT load, not floor area. The planned first phase is {compute.load}. Leave it
              blank if you do not know yet — a technical input you have not measured is
              better left empty than guessed.
            </span>
          </p>

          <p class="field">
            <label class="field__label" for="live">Target live date</label>
            <input class="field__input" id="live" name="live_date" type="month" aria-describedby="live-hint" />
            <span class="field__hint" id="live-hint">Site power-on target is {site.powerOn}.</span>
          </p>

          <p class="field">
            <label class="field__label" for="cooling">Cooling requirement</label>
            <select class="field__input" id="cooling" name="cooling">
              <option value="">Choose one</option>
              <option value="liquid">Direct-to-chip liquid</option>
              <option value="air">Air cooled</option>
              <option value="mixed">Both — dense racks plus air-cooled support kit</option>
              <option value="unsure">Not sure yet</option>
            </select>
          </p>
        </div>

        <p class="field field--wide">
          <label class="field__label" for="notes">Anything else we should know</label>
          <textarea
            class="field__input field__input--area"
            id="notes"
            name="notes"
            rows="5"
            aria-describedby="notes-hint"></textarea>
          <span class="field__hint" id="notes-hint">
            Workload shape, GPU count, compliance gates, and the diligence items you need
            answered before you can sign. The open items on these pages are open on
            purpose — asking about them is the fastest route to a real answer.
          </span>
        </p>
      </fieldset>

      <div class="form__actions">
        <p class="form__status" data-form-status role="status" tabindex="-1" hidden></p>
        <button class="btn form__submit" type="submit">
          Request a deployment review
          <span class="form__submit-arrow" aria-hidden="true">→</span>
        </button>
        <span class="form__req-note">
          Fields marked <span class="field__req" aria-hidden="true">*</span> are required;
          leave any technical input blank if it is not yet known. A person reads this,
          not a sequence.
        </span>
      </div>
    </form>
  </section>

  <section class="is-end" aria-labelledby="direct" data-reveal>
    <p class="eyebrow" aria-hidden="true"><span class="eyebrow__n">02</span><span class="eyebrow__t">Direct</span></p>
    <h2 id="direct">Other ways to reach us</h2>

    <div class="split">
      <dl class="spec">
        <div><dt>Email</dt><dd><span class="todo">[PLACEHOLDER: sales email address]</span></dd></div>
        <div><dt>Phone</dt><dd><span class="todo">[PLACEHOLDER: phone number and hours it is answered]</span></dd></div>
        <div>
          <dt>Site address</dt>
          <dd>
            <address class="addr">
              {company.full}<br />
              {site.designation}<br />
              {site.address}<br />
              {site.county}, Oklahoma
            </address>
          </dd>
        </div>
        <div><dt>Site visits</dt><dd>Arranged individually. <span class="todo">[PLACEHOLDER: notice required for a site visit, and who escorts]</span></dd></div>
        <div><dt>Response time</dt><dd><span class="todo">[PLACEHOLDER: committed response time for enquiries]</span></dd></div>
      </dl>

      <div class="stack">
        <div class="callout">
          <p>
            <strong>The short version, if you are comparing sites.</strong> The industry
            grid interconnection timelines gate most new capacity. {site.designation} never
            entered it, because the {power.service} service is already standing on
            land we own and the generation sits behind the meter. Phase 1A uses
            {' '}the site. What it can carry as IT load follows an engineering review.
          </p>
        </div>

        <div>
          <h3>What happens after you send this</h3>
          <ol class="bullets">
            <li>We read it. A person, usually the same day the enquiry lands.</li>
            <li>We tell you what is genuinely available at {site.designation} for your load and your date — including if the answer is no.</li>
            <li>We answer the open items on these pages that are gates for you, in writing.</li>
            <li>Site visit at {site.name}, if the numbers survive step two.</li>
          </ol>
          <p class="fineprint">
            Step 1 timing above is our intent, not a contractual commitment — see the
            response-time placeholder opposite.
          </p>
        </div>
      </div>
    </div>
  </section>
</Content>

<style>
  .form__status {
    margin: 0 0 var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-signal);
    color: var(--w-90);
    font-size: var(--t-read);
    max-width: 60ch;
  }
</style>

<script>
  /*
   * Delivery, not the appearance of it.
   *
   * This handler used to intercept a valid submission and display a thank-you
   * that acknowledged, in its own words, that nothing had been sent. That was
   * at least honest — the capture bar on the homepage was not — but neither
   * delivered anything.
   *
   * It now posts through the shared inquiry module, which reports success only
   * on a server acknowledgment. Every failure path keeps the form exactly as
   * the visitor typed it: the fields are never cleared unless the inquiry
   * actually left.
   */
  import { submitInquiry, failureMessage } from '../lib/inquiry';

  const form = document.querySelector<HTMLFormElement>('#reserve-enquiry, form[action="/api/reserve"]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let sending = false;

  const say = (text: string): void => {
    if (!status) return;
    status.textContent = text;
    status.hidden = false;
    status.focus();
  };

  form?.addEventListener('submit', (e) => {
    if (!form.checkValidity()) return;
    e.preventDefault();
    if (sending) return;

    sending = true;
    if (submit) submit.disabled = true;
    form.dataset.state = 'sending';
    if (status) { status.textContent = 'Sending…'; status.hidden = false; }

    const payload: Record<string, unknown> = { source: 'contact-page' };
    for (const [key, value] of new FormData(form).entries()) {
      if (typeof value === 'string' && value.trim() !== '') payload[key] = value.trim();
    }

    void submitInquiry(payload).then((result) => {
      sending = false;
      if (submit) submit.disabled = false;
      if (result.ok) {
        form.dataset.state = 'sent';
        say('Received. We will confirm workload suitability, equipment availability, facility allocation and commercial terms before issuing an offer.');
        form.reset();
        return;
      }
      form.dataset.state = 'error';
      say(failureMessage(result.reason));
      // No reset. Everything typed stays where it is.
    });
  });
</script>


<style>
  /* These are <p> elements inside .doc, so they carry .doc's own paragraph
     rules. Matching that specificity here keeps the form layout independent
     of how the scoped-style strategy is configured. */
  .doc .form-note { margin-bottom: var(--s-7); }

  .form { display: grid; gap: clamp(var(--s-7), 6vw, var(--s-8)); max-width: 820px; }

  /* No boxes. Each group is a ruled band with its own index, so the form reads
     as part of the same document rather than as a widget dropped into it. */
  .form__set {
    margin: 0;
    padding: var(--s-6) 0 0;
    border: 0;
    border-top: 1px solid var(--w-25);
  }

  .form__legend {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: 0;
    margin-bottom: var(--s-6);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-70);
  }
  .form__legend-n {
    font-variant-numeric: tabular-nums;
    color: var(--c-signal);
  }

  .form__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: var(--s-7) var(--s-6);
  }

  .doc .field { display: grid; gap: var(--s-3); margin: 0; max-width: none; min-width: 0; align-content: start; }
  .doc .field--wide { margin-top: var(--s-8); }

  .field__label {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
    transition: color var(--d-fast);
  }
  .field:focus-within .field__label { color: var(--w-95); }
  .field__req { color: var(--c-gold); }

  /* An underlined field, not a chip: it sits on the page's own rule system. */
  .field__input {
    width: 100%;
    min-width: 0;
    padding: var(--s-2) 0 var(--s-3);
    border: 0;
    border-bottom: 1px solid var(--w-25);
    border-radius: 0;
    background: none;
    color: var(--w-95);
    font-family: var(--f-sans);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    line-height: 1.4;
    transition: border-color var(--d-fast), background var(--d-fast);
  }
  .field__input:hover { border-bottom-color: var(--w-45); }
  .field__input:focus {
    outline: none;
    border-bottom-color: var(--c-signal);
    background: linear-gradient(180deg, transparent 60%, color-mix(in srgb, var(--c-signal) 8%, transparent));
  }
  /* Keyboard users still get the ring the rest of the site uses. */
  .field__input:focus-visible {
    outline: 2px solid var(--c-signal);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }
  .field__input::placeholder { color: var(--w-30); }
  .field__input--area {
    resize: vertical;
    min-height: 6.5em;
    padding: var(--s-3) 0;
    font-family: var(--f-sans);
  }

  /* Selects lose their native chevron on a borderless field, so draw one. */
  select.field__input {
    appearance: none;
    -webkit-appearance: none;
    padding-right: var(--s-6);
    background-image: linear-gradient(45deg, transparent 50%, var(--w-55) 50%),
                      linear-gradient(135deg, var(--w-55) 50%, transparent 50%);
    background-position: right 10px center, right 4px center;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  select.field__input:focus {
    background-image: linear-gradient(45deg, transparent 50%, var(--c-signal) 50%),
                      linear-gradient(135deg, var(--c-signal) 50%, transparent 50%),
                      linear-gradient(180deg, transparent 60%, color-mix(in srgb, var(--c-signal) 8%, transparent));
    background-position: right 10px center, right 4px center, 0 0;
    background-size: 6px 6px, 6px 6px, 100% 100%;
  }

  /* The native select popup is drawn by the OS, so its options need a colour
     that survives being rendered on a light system menu. */
  .field__input option { color: var(--c-carbon); background: var(--c-white); }

  .field__hint {
    font-size: 13px;
    line-height: 1.6;
    color: var(--w-45);
    text-wrap: pretty;
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--w-25);
  }
  .form__submit { padding: 15px 28px; }
  .form__submit-arrow {
    display: inline-block;
    transition: transform var(--d-fast) var(--e-out);
  }
  .form__submit:hover .form__submit-arrow { transform: translateX(4px); }
  .form__req-note {
    max-width: 42ch;
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    letter-spacing: var(--ls-mid);
    text-transform: uppercase;
    color: var(--w-45);
  }

  .addr { font-style: normal; line-height: 1.7; }

  .doc .fineprint { font-size: 13px; color: var(--w-45); }

  @media (prefers-reduced-motion: reduce) {
    .form__submit:hover .form__submit-arrow { transform: none; }
  }

  /* Touch targets, placed last so source order carries them. Measured on
     WebKit at an iPhone 14 profile: the fields came out at 42.3px and the
     submit at 43px — short by a whisker, but short. */
  @media (pointer: coarse), (max-width: 760px) {
    .field__input { padding-block: 13px; }
    /* .btn also sets padding, so match its specificity to win. */
    .btn.form__submit { padding-block: 17px; }
  }
</style>
