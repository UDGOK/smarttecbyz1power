---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { campusConcept } from '../../data/site';
import '../../smarttec-campus/campus.css';
---
<Base title="Explore the campus in 3D | SmartTec by Z1Power" description="Explore SmartTec’s proposed Mead, Oklahoma campus in 16 rendered views and interactive 3D: compute, liquid cooling, future energy and inverter manufacturing.">
<SiteHeader />
<div class="campus-experience"><main id="main">

<div class="campus-breadcrumb"><a href="/site">← Site 01 overview</a><a href="/contact">Arrange a site visit ↗</a></div><div class="intro"><div><p class="eyebrow">8460 US 70 · MEAD, OKLAHOMA</p><h1>One campus.<br><em>A closer sense of place.</em></h1></div><p class="intro-note">Explore the campus through refined materials, daylight and detailed interiors. Turn on system tracing when you want to follow a connection.<br><span>Proposed campus · 16 rendered views + interactive 3D</span></p></div>
<p class="campus-basis-note">A proposed spatial and cooling study. {campusConcept.budgetBasis}</p>
<section class="workspace" aria-label="Campus design viewer">
<aside><p class="eyebrow">EXPLORE THE CAMPUS</p><nav id="views" aria-label="Campus views"><button type="button" data-view="01-campus-aerial" aria-pressed="false"><span>01</span>Campus overview</button><button type="button" data-view="02-inverter-arrival" aria-pressed="false"><span>02</span>Inverter manufacturing</button><button type="button" data-view="03-compute-cooling" aria-pressed="false"><span>03</span>A / B / C + cooling</button><button type="button" data-view="04-operations-cutaway" aria-pressed="false"><span>04</span>Inside A, B and C</button><button type="button" data-view="05-manufacturing-cutaway" aria-pressed="false"><span>05</span>Inside manufacturing</button><button type="button" data-view="06-solar-approach" aria-pressed="false"><span>06</span>Future solar field</button><button type="button" data-view="07-north-up-plan" aria-pressed="false"><span>07</span>North-up master plan</button><button type="button" data-view="08-campus-dusk" aria-pressed="false"><span>08</span>Blue-hour operations</button><button type="button" data-view="09-systems-overview" aria-pressed="false"><span>09</span>Systems overview</button><button type="button" data-view="10-rack-liquid-cooling" aria-pressed="false"><span>10</span>Rack liquid cooling</button><button type="button" data-view="11-bess-power" aria-pressed="false"><span>11</span>BESS + power</button><button type="button" data-view="12-fiber-handoff" aria-pressed="false"><span>12</span>Dobson fiber handoff</button><button type="button" data-view="13-hero-arrival" aria-pressed="true"><span>13</span>Campus arrival</button><button type="button" data-view="14-datahall-interior" aria-pressed="false"><span>14</span>Data hall interior</button><button type="button" data-view="15-cooling-plant-detail" aria-pressed="false"><span>15</span>Cooling plant detail</button><button type="button" data-view="16-manufacturing-interior" aria-pressed="false"><span>16</span>Manufacturing interior</button></nav><div class="phase"><span>DEVELOPMENT SEQUENCE</span><p>Grid first.<br>Solar and BESS follow.</p><small>Future equipment is shown for spatial review. Activation and islanding remain to be designed.</small></div></aside>
<div class="visual-column"><div class="toolbar"><div class="segmented"><button id="image-mode" aria-pressed="true">Rendered view</button><button id="model-mode" aria-pressed="false">Explore in 3D</button></div><div class="actions"><button id="cutaway" aria-pressed="false" hidden>Remove shell</button><button id="reset" hidden>Reset view</button><button id="fullscreen" aria-label="Open viewer fullscreen">⛶ <span>Fullscreen</span></button></div></div>
<div class="appearance-bar"><div><p class="eyebrow">3D APPEARANCE</p><div class="appearance-options" role="group" aria-label="3D material appearance"><button data-appearance="photoreal" aria-pressed="true">Photoreal materials</button><button data-appearance="system" aria-pressed="false">System colors</button></div></div><label class="quality-control" for="quality"><span>3D QUALITY</span><select id="quality"><option value="balanced">Balanced</option><option value="high">High</option></select></label><span class="quality-note" id="quality-note">Balanced · efficient detail</span></div><div class="systems-bar"><div><p class="eyebrow">TRACE A SYSTEM</p><div class="system-tabs" role="group" aria-label="System overlays"><button data-system="all" aria-pressed="false">All systems</button><button data-system="cooling" aria-pressed="false"><i class="dot cooling"></i>Cooling</button><button data-system="power" aria-pressed="false"><i class="dot power"></i>Power</button><button data-system="fiber" aria-pressed="false"><i class="dot fiber"></i>Fiber</button></div></div><button id="stop-tracing" class="motion-button" hidden>Close trace</button><button id="motion" class="motion-button" aria-pressed="false" disabled>Pause motion</button></div>
<div class="overlay-note" id="overlay-note" role="status">Rendered in Blender · select Explore in 3D for interactive materials and lighting.</div>
<div class="stage" id="stage"><img id="render" width="1600" height="900" fetchpriority="high" decoding="async" sizes="(max-width:760px) 100vw, 80vw" srcset="/assets/campus/2026-09/renders/13-hero-arrival-1600.webp 1600w, /assets/campus/2026-09/renders/13-hero-arrival-2400.webp 2400w" src="/assets/campus/2026-09/renders/13-hero-arrival-1600.webp" alt="A photographic Blender study of the proposed SmartTec campus arrival"><div id="canvas" hidden></div><div id="labels" hidden></div><div id="loading" role="status" aria-live="polite" hidden>Loading Blender geometry and system routes…</div><div class="view-counter" id="view-counter">13 / 16</div><div class="scene-tag">BLENDER DESIGN STUDY · PROPOSED CAMPUS</div></div>
<div class="flow-legend" hidden aria-label="System flow legend"><span><i class="line-key fws-supply"></i>FWS supply</span><span><i class="line-key fws-return"></i>FWS return</span><span><i class="line-key tcs-supply"></i>TCS supply</span><span><i class="line-key tcs-return"></i>TCS return</span><span><i class="line-key power"></i>AC power</span><span><i class="line-key dc"></i>DC / BESS</span><span><i class="line-key fiber"></i>Fiber</span><span><i class="line-key future"></i>Future branch</span><small>FWS = facility water · TCS = server coolant. Moving dots show direction only, without speed, capacity or load data. Static detail does not imply equipment is off.</small></div>
<div class="caption"><div><p class="eyebrow" id="view-kicker">ARRIVAL / MATERIALS STUDY</p><h2 id="view-title">A campus with presence.</h2><p id="view-description">Explore the proposed A/B/C campus, cooling yard and manufacturing hall through renders and an interactive model.</p></div><a id="full-image" href="/assets/campus/2026-09/renders/13-hero-arrival-2400.webp" target="_blank" rel="noopener">Open large render ↗</a></div><p id="status" role="status">Select a system to load the interactive model, or explore the rendered views.</p></div>
</section>
<section class="system-summary" aria-labelledby="system-summary-title"><div class="summary-heading"><div><p class="eyebrow">READ THE ROUTE</p><h2 id="system-summary-title">Three systems. Clear connections.</h2></div><a href="#design-basis">Design basis ↓</a></div><div class="flow-cards"><article data-flow="cooling"><span class="system-label cooling">COOLING / PROPOSED DLC</span><h3>Two circuits, one heat exchange.</h3><p class="route-text">Daikin plant <b>→</b> facility water <b>→</b> CDU primary <b>→</b> plant</p><p class="route-text">CDU secondary <b>→</b> overhead headers <b>→</b> rack manifolds <b>→</b> B300 cold plates <b>→</b> CDU</p><p>Facility water and server coolant stay in separate loops. Room cooling still handles residual heat and humidity.</p></article><article data-flow="power"><span class="system-label power">POWER / GRID FIRST</span><h3>A future branch at the common bus.</h3><p class="route-text">Utility <b>→</b> main distribution <b>→</b> UPS <b>→</b> IT distribution</p><p class="route-text future-route">Future BESS <b>↔</b> PCS <b>↔</b> common bus <b>←</b> future PV</p><p>BESS and its PCS are a separate branch from the IT UPS. Future activation is conceptual; islanding is not established.</p></article><article data-flow="fiber"><span class="system-label fiber">FIBER / HANDOFF IN B</span><h3>From the demarcation to compute.</h3><p class="route-text">Dobson <b>→</b> handoff in B <b>↔</b> site network <b>↔</b> A + C</p><p>The owner confirms the handoff in Building B. The external approach and internal routes remain illustrative; route diversity is unverified.</p></article></div></section>
<section class="facts" aria-label="System design basis"><article><span>01 / COMPUTE</span><h3>Direct liquid B300</h3><p>Proposed Supermicro eight-GPU servers in A and C. Final server SKU, rack arrangement and thermal duties remain open.</p></article><article><span>02 / HEAT REJECTION</span><h3>Daikin · 208V</h3><p>Owner requirement: closed-loop Daikin plant at 208V. Exact chiller model, circuit compatibility and ratings are to be confirmed.</p></article><article><span>03 / NETWORK</span><h3>Dobson → B</h3><p>Owner-confirmed handoff location. Provider entry route, service details and any resilient paths are unverified.</p></article><article><span>04 / ENERGY</span><h3>Future BESS + PV</h3><p>Conceptual PCS branch at distribution, separate from the UPS. No capacity, runtime, redundancy or islanding claim.</p></article></section>
<details class="basis" id="design-basis"><summary>What is source-based, and what is illustrative? <span>+</span></summary><div><p><b>Source-based:</b> survey tract arrangement and relative building positions; manufacturer’s nominal hall dimensions, roof pitch, frame spacing and door arrangement; owner’s A/B/C equipment assignments and Dobson handoff in B. The cooling study follows OEM guidance for separate facility and server-coolant circuits. Final equipment selection and installation require project engineering.</p><p><b>Illustrative:</b> area-normalized A/B/C footprints, building heights and finishes, equipment envelopes, the four-plus-four compute split, utility routing, support spacing and installation details. This is a modeled design concept, not site photography, georeferenced mapping or construction documentation. Circuit colors are viewer conventions.</p><p>{campusConcept.budgetBasis}</p><p>The site address used here is <b>8460 US 70, Mead, Oklahoma 73449</b>. Relative positions follow the supplied plan; address registration and ground elevations remain unverified.</p></div></details>

<p class="campus-credit">Architectural visualization of proposed facilities. <a href="/assets/campus/2026-09/credits.txt" target="_blank" rel="noopener">Materials and lighting credits ↗</a></p>
<noscript><p>JavaScript is needed for camera selection and interactive 3D. Open any rendered view below.</p><ul><li><a href="/assets/campus/2026-09/renders/01-campus-aerial-2400.webp">Campus overview</a></li><li><a href="/assets/campus/2026-09/renders/02-inverter-arrival-2400.webp">Inverter manufacturing</a></li><li><a href="/assets/campus/2026-09/renders/03-compute-cooling-2400.webp">A / B / C + cooling</a></li><li><a href="/assets/campus/2026-09/renders/04-operations-cutaway-2400.webp">Inside A, B and C</a></li><li><a href="/assets/campus/2026-09/renders/05-manufacturing-cutaway-2400.webp">Inside manufacturing</a></li><li><a href="/assets/campus/2026-09/renders/06-solar-approach-2400.webp">Future solar field</a></li><li><a href="/assets/campus/2026-09/renders/07-north-up-plan-2400.webp">North-up master plan</a></li><li><a href="/assets/campus/2026-09/renders/08-campus-dusk-2400.webp">Blue-hour operations</a></li><li><a href="/assets/campus/2026-09/renders/09-systems-overview-2400.webp">Systems overview</a></li><li><a href="/assets/campus/2026-09/renders/10-rack-liquid-cooling-2400.webp">Rack liquid cooling</a></li><li><a href="/assets/campus/2026-09/renders/11-bess-power-2400.webp">BESS + power</a></li><li><a href="/assets/campus/2026-09/renders/12-fiber-handoff-2400.webp">Dobson fiber handoff</a></li><li><a href="/assets/campus/2026-09/renders/13-hero-arrival-2400.webp">Campus arrival</a></li><li><a href="/assets/campus/2026-09/renders/14-datahall-interior-2400.webp">Data hall interior</a></li><li><a href="/assets/campus/2026-09/renders/15-cooling-plant-detail-2400.webp">Cooling plant detail</a></li><li><a href="/assets/campus/2026-09/renders/16-manufacturing-interior-2400.webp">Manufacturing interior</a></li></ul></noscript>
</main></div>
<SiteFooter />
</Base>
<script>import '../../smarttec-campus/viewer.mjs';</script>
