---
import Base from '../layouts/Base.astro';
import ScrollRuler from '../components/chrome/ScrollRuler.astro';
import PowerBadge from '../components/chrome/PowerBadge.astro';
import Brandmark from '../components/chrome/Brandmark.astro';
import CtaBar from '../components/chrome/CtaBar.astro';
import { company, site, stages } from '../data/site';

const visible = stages.slice(0, 2); // vertical slice: stages 1–2
---
<Base
  title={`${company.full} — AI data centers, Mead Oklahoma`}
  description={`${site.acres} acres in ${site.county}, Oklahoma. Behind-the-meter power, no interconnection queue, ${site.powerOn} power-on. Colocation and GPU capacity from SmartTec by Z1Power.`}
  experience
>
  <canvas id="experience-canvas" aria-hidden="true"></canvas>
  <div class="scrim" aria-hidden="true"></div>

  <main id="main" data-stage-root>
    <Brandmark />
    <ScrollRuler />
    <PowerBadge />

    {visible.map((stage, i) => (
      <section
        class="stage-panel"
        data-stage-panel
        data-stage={stage.id}
        hidden={i !== 0}
        aria-label={stage.kicker}
      >
        <p class="stage-panel__kicker mono-label" data-reveal>{stage.kicker}</p>
        {i === 0 ? (
          <h1 class="stage-panel__title" data-reveal>
            {stage.title.split('\n').map((line) => <span class="line">{line}</span>)}
          </h1>
        ) : (
          <h2 class="stage-panel__title" data-reveal>
            {stage.title.split('\n').map((line) => <span class="line">{line}</span>)}
          </h2>
        )}
        <p class="stage-panel__lede" data-reveal>{stage.lede}</p>
      </section>
    ))}

    <div id="hold-slot" class="hold-slot"></div>
    <CtaBar />
  </main>

  <!-- Complete static reading path: present for search engines, screen readers
       and anyone the cinematic layer cannot serve. -->
  <section class="static-path" id="static-path">
    <h2>Site 01 — {site.address}</h2>
    <dl>
      <div><dt>Land</dt><dd>{site.acres} acres, {site.ownership.toLowerCase()}, {site.county}</dd></div>
      <div><dt>Buildings</dt><dd>{site.buildings.length} × {site.buildings[0].sqft.toLocaleString()} sqft</dd></div>
      <div><dt>Power-on</dt><dd>{site.powerOn}</dd></div>
    </dl>
  </section>
</Base>

<script>
  import { boot } from '../lib/boot';
  boot();
</script>

<style>
  #experience-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-canvas);
    /* Painted before WebGL initialises, and the whole picture if it never does. */
    background: radial-gradient(120% 90% at 50% 15%, #2d6a54 0%, #1c4839 45%, #0d2119 100%);
  }

  /* Readability scrim: guarantees contrast for the lede and the floating
     chrome regardless of what the shader is doing behind them. */
  .scrim {
    position: fixed;
    inset: auto 0 0 0;
    height: 46vh;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, #071410cc 0%, #07141066 45%, #0714100a 100%);
  }

  main {
    position: relative;
    z-index: var(--z-content);
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: calc(var(--chrome-inset) * 6) var(--s-5) 140px;
  }

  @media (max-width: 640px) {
    main { padding: calc(var(--chrome-inset) * 4) var(--s-4) 170px; }
    .scrim { height: 56vh; }
  }

  .stage-panel {
    max-width: 72ch;
    text-align: center;
    transition: opacity var(--d-base) var(--e-out);
  }
  .stage-panel__kicker { display: block; margin: 0 0 var(--s-5); }

  .stage-panel__title,
  h2.stage-panel__title {
    margin: 0 0 var(--s-5);
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--t-display);
    line-height: 0.94;
    letter-spacing: -0.02em;
    color: var(--chrome-fg-loud);
    text-wrap: balance;
  }
  .stage-panel__title .line { display: block; }

  .stage-panel__lede {
    margin: 0 auto;
    max-width: 52ch;
    font-size: var(--t-lede);
    line-height: 1.45;
    color: var(--chrome-fg);
    text-wrap: pretty;
  }

  .hold-slot {
    position: fixed;
    left: 50%;
    bottom: 104px;
    transform: translateX(-50%);
    z-index: var(--z-chrome);
  }

  .static-path {
    position: relative;
    z-index: var(--z-content);
    max-width: 62ch;
    margin: 0 auto;
    padding: var(--s-9) var(--s-5);
    color: var(--w-70);
  }
  .static-path h2 { font-family: var(--f-display); font-weight: 400; }
  .static-path dl { display: grid; gap: var(--s-3); margin: 0; }
  .static-path dl > div { display: flex; gap: var(--s-4); border-top: 1px solid var(--w-10); padding-top: var(--s-3); }
  .static-path dt { flex: 0 0 9rem; font-family: var(--f-mono); font-size: var(--t-label); letter-spacing: var(--ls-wide); text-transform: uppercase; color: var(--w-45); }
  .static-path dd { margin: 0; }

  /* Static path is a fallback, not a second hero — hidden once JS confirms the
     experience is running, but always in the DOM for crawlers and AT. */
  :global(html.js-ready) .static-path { display: none; }
</style>
