---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';

/**
 * The reference's three commercial faces. We cannot ship them, but every token
 * stack already names them first — so the moment the licensed files are dropped
 * into public/assets/fonts the type becomes an exact match.
 *
 * The @font-face rules are emitted only for files that actually exist at build
 * time. Declaring them unconditionally would 404 on every page view.
 */
const LICENSED_FACES = [
  // Ratch is the intended primary face: a variable geometric grotesk. Both a
  // variable file and static cuts are accepted, so whichever the licence ships
  // will be picked up.
  { family: 'Ratch', file: 'Ratch-Variable.woff2', weight: '100 900' },
  { family: 'Ratch', file: 'Ratch-Regular.woff2', weight: '400' },
  { family: 'Ratch', file: 'Ratch-Medium.woff2', weight: '500' },
  { family: 'Ratch', file: 'Ratch-Bold.woff2', weight: '700' },
  { family: 'PP Supply Mono', file: 'PPSupplyMono-Regular.otf', weight: '400' },
  { family: 'PP Supply Sans', file: 'PPSupplySans-Regular.otf', weight: '400' },
  { family: 'STK Bureau Serif', file: 'STKBureau-SerifBook.otf', weight: '400' },
] as const;

const fontDir = path.join(process.cwd(), 'public', 'assets', 'fonts');
const licensed = LICENSED_FACES.filter((f) => fs.existsSync(path.join(fontDir, f.file)));

interface Props {
  title: string;
  description: string;
  /** Cinematic routes take over the viewport; content routes scroll normally. */
  experience?: boolean;
}
const { title, description, experience = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * Share card. Absolute, because Open Graph consumers do not resolve relative
 * URLs — built from the same origin as the canonical link so it follows the
 * production domain rather than being pinned to a deploy host.
 */
const ogImage = new URL('/assets/smarttec/smarttec-og-1200x630.png', Astro.site);
const ogImageAlt = 'SmartTec by Z1Power — data centers and colocation';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- .ico for the browsers and crawlers that still ask for one by name. -->
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c4839" />

    {licensed.length > 0 && (
      <style set:html={licensed
        .map((f) => {
          const fmt = f.file.endsWith('.woff2') ? 'woff2' : 'opentype';
          return `@font-face{font-family:'${f.family}';src:url('/assets/fonts/${f.file}') format('${fmt}');font-weight:${f.weight};font-style:normal;font-display:swap}`;
        })
        .join('')} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SmartTec by Z1Power" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The five faces the reference itself loads from Google Fonts, matched
         exactly, plus the two stand-ins for its commercial display faces.
         See public/assets/fonts/README.md. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,600&family=Space+Grotesk:wght@300;400;500;600;700&family=Caveat:wght@700&family=Google+Sans+Code:wght@400;700&family=Google+Sans+Flex:wght@400;500;600&family=Inter:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,500;1,400&family=Pinyon+Script&display=swap"
    />
  </head>
  <body data-experience={experience ? '' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
