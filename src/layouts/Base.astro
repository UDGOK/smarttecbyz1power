---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
import SiteFonts from '../components/SiteFonts.astro';

interface Props {
  title: string;
  description: string;
  /** Cinematic routes take over the viewport; content routes scroll normally. */
  experience?: boolean;
  /**
   * Keep the page out of search results and off the sitemap.
   *
   * Unlisted, which is not the same as private: anyone holding the URL can
   * open it, and the files it links to are served from the same public origin
   * whether or not this page exists. Use it to keep a page out of the way, not
   * to keep anything secret.
   */
  noindex?: boolean;
}
const { title, description, experience = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * Share card. Absolute, because Open Graph consumers do not resolve relative
 * URLs — built from the same origin as the canonical link so it follows the
 * production domain rather than being pinned to a deploy host.
 */
const ogImage = new URL('/assets/smarttec/smarttec-og-1200x630.png', Astro.site);

/**
 * The kit's particle stylesheet, inlined at build time from the file the
 * animation actually ships with rather than transcribed — so it cannot drift
 * from public/assets/smarttec/. 428 bytes, used by the entry card, which is
 * the very first paint: a separate render-blocking request for that would be
 * worse than the bytes.
 */
let particleCss = '';
try {
  particleCss = fs
    .readFileSync(path.join(process.cwd(), 'public/assets/smarttec/smarttec-particles.css'), 'utf8')
    .trim();
} catch {
  particleCss = '';
}

const ogImageAlt = 'SmartTec by Z1Power — data centers and colocation';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- .ico for the browsers and crawlers that still ask for one by name. -->
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c4839" />
    {particleCss && <style set:html={particleCss} />}

    <SiteFonts />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SmartTec by Z1Power" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The five faces the reference itself loads from Google Fonts, matched
         exactly, plus the two stand-ins for its commercial display faces.
         See public/assets/fonts/README.md. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,600&family=Space+Grotesk:wght@300&family=Caveat:wght@700&family=Google+Sans+Flex:wght@400;500;600&family=Inter:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,500;1,400&family=Pinyon+Script&display=swap"
    />
  </head>
  <body data-experience={experience ? '' : undefined} data-entry-pending={experience ? '' : undefined}>
    <a class="skip-link" href="#main" inert={experience} data-entry-content={experience ? '' : undefined}>Skip to content</a>
    <slot />
  </body>
</html>
