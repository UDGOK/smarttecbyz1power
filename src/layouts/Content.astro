---
/**
 * The reading shell.
 *
 * Base.astro owns the document; this owns the page. Content routes never pass
 * `experience` — they scroll normally, render server-side, and carry no WebGL,
 * no audio and no loader.
 *
 * Typographically these pages answer to the cinematic route: one enormous
 * display statement per page, tiny wide-tracked mono labels, a persistent
 * section rail, and the site's own figures set as display elements rather than
 * as table cells. The motion is deliberately small — a lift on entry, a rule
 * that draws, a figure that counts, a rail that marks where you are. Nothing
 * delays reading and nothing is scroll-jacked.
 *
 * The typographic primitives below are `is:global` because they style slotted
 * page content, which Astro's scoping cannot reach. Every rule is descended
 * from `.doc` so nothing leaks onto the cinematic route.
 */
import Base from './Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

/** A hero figure. `value` is always a string taken from src/data/site.ts. */
export interface HeroMeta {
  label: string;
  value: string;
  /** Optional trailing gloss, one short line. */
  note?: string;
  tone?: 'signal' | 'gold';
  /** Set when `value` starts with a plain integer that may count up. */
  count?: boolean;
}

interface Props {
  title: string;
  description: string;
  /** Small mono line above the h1 — where you are, not what this is. */
  kicker: string;
  /** The single h1 for the page. */
  heading: string;
  /** One paragraph. The argument, not a summary. */
  lede: string;
  /** Four-ish figures set under the hero rule. Every value comes from site.ts. */
  meta?: HeroMeta[];
}

const { title, description, kicker, heading, lede, meta = [] } = Astro.props;
---

<Base title={title} description={description}>
  <script is:inline>
    /* Runs before the page paints so revealed sections never flash in and out.
       No observer support, or reduced motion, means no class and no hiding.

       The reveal deliberately lives here rather than in the bundled module:
       if the module ever fails to load, the reading path must still be whole.
       The timer below is the second belt — if nothing has marked itself in
       after 2s, the hiding class is dropped and everything is simply there. */
    (function () {
      var root = document.documentElement;

      /* Order matters more than anything else here. `reveal-on` is what HIDES
         the content; it must not be added until the machinery that reveals it
         again is known to exist and to work. The previous version added it
         first and then constructed the observer — so anything that made that
         constructor throw (a stubbed API, an extension, an older engine) left
         every section below the fold permanently invisible with no way back.
         The whole block is wrapped, and any failure undoes the hiding. */
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (typeof window.IntersectionObserver !== 'function') return;

        var observed = false;
        var io = new IntersectionObserver(function (entries) {
          observed = true;
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add('is-in');
              io.unobserve(entries[i].target);
            }
          }
        }, { rootMargin: '0px 0px 22% 0px', threshold: 0 });

        /* Plain arithmetic, no observer involved: anything whose top has come
           within a screen of the fold is revealed. A second mechanism, so a
           single failure cannot leave the page's own words invisible. */
        var sweep = function () {
          var els = document.querySelectorAll('[data-reveal]:not(.is-in)');
          if (!els.length) { window.removeEventListener('scroll', onScroll); return; }
          var limit = window.innerHeight * 1.25;
          for (var i = 0; i < els.length; i++) {
            if (els[i].getBoundingClientRect().top < limit) els[i].classList.add('is-in');
          }
        };
        var ticking = false;
        var onScroll = function () {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () { ticking = false; sweep(); });
        };

        var start = function () {
          try {
            var els = document.querySelectorAll('[data-reveal]');
            for (var i = 0; i < els.length; i++) io.observe(els[i]);
            sweep();
          } catch (e) { root.classList.remove('reveal-on'); }
        };

        // Only now is it safe to hide anything.
        root.classList.add('reveal-on');
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }

        // The observer reports on every target as soon as it is observed, so
        // silence means something is wrong.
        window.setTimeout(function () {
          if (!observed) root.classList.remove('reveal-on');
        }, 2000);

        // Last resort: nothing stays hidden forever. The effect has had its
        // chance and the words matter more.
        window.setTimeout(function () {
          if (document.querySelectorAll('[data-reveal]:not(.is-in)').length) {
            root.classList.remove('reveal-on');
          }
        }, 10000);
      } catch (e) {
        root.classList.remove('reveal-on');
      }
    })();
  </script>

  <SiteNav />

  <main class="doc" id="main">
    <header class="doc__head">
      <p class="doc__kicker">
        <span class="doc__kicker-rule" aria-hidden="true"></span>{kicker}
      </p>

      <h1 class="doc__title">{heading}</h1>

      <div class="doc__lede-row">
        <p class="doc__lede">{lede}</p>
      </div>

      <div class="doc__rule" data-hero-rule aria-hidden="true"></div>

      {meta.length > 0 && (
        <dl class="doc__meta">
          {meta.map((m) => (
            <div class="doc__meta-item">
              <dt>{m.label}</dt>
              <dd
                class={m.tone === 'signal' ? 'is-signal' : m.tone === 'gold' ? 'is-gold' : undefined}
              >
                <span class="doc__meta-value" data-count={m.count ? '' : undefined}>{m.value}</span>
                {m.note && <span class="doc__meta-note">{m.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </header>

    <slot />
  </main>

  <SiteFooter />

  <script>
    import '../lib/content-motion';
  </script>
</Base>

<style is:global>
  /* ============================================================
     Reading-page primitives. All descended from .doc.
     ============================================================ */

  :root {
    --nav-h: 58px;
  }

  .doc {
    /* Motion here follows the reference's vocabulary: power2.out — `--e-p2`
       from the shared set in chrome.css — at 0.3–0.65s. These pages ran on an
       expo-shaped curve at 0.8–1.3s, which is what read as aggressive rather
       than gentle. */
    --doc-w: 1240px;
    --doc-read: 66ch;
    --rail: 8.5rem;

    /* One fearless step from 10px mono to the page statement. */
    --t-page-title: clamp(2.35rem, 1.0rem + 5.6vw, 6.6rem);
    --t-h2: clamp(1.75rem, 1.1rem + 2.3vw, 3.2rem);
    --t-h3: clamp(1.02rem, 0.96rem + 0.3vw, 1.16rem);
    --t-figure: clamp(1.85rem, 1.25rem + 1.9vw, 2.9rem);
    --t-mega: clamp(2.6rem, 1.3rem + 4.6vw, 5.6rem);

    width: min(var(--doc-w), 100%);
    margin: 0 auto;
    padding: 0 var(--s-4);
  }

  /* ---- Page header ----
     Asymmetric on purpose: the statement runs to the left edge of the measure
     and the lede is set in from it, so the two never read as one block. */
  .doc__head {
    position: relative;
    padding: clamp(var(--s-8), 13vh, 168px) 0 clamp(var(--s-7), 7vh, var(--s-9));
  }

  .doc__kicker {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin: 0 0 clamp(var(--s-6), 5vh, var(--s-8));
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-55);
  }
  .doc__kicker-rule {
    flex: 0 0 auto;
    width: clamp(24px, 5vw, 56px);
    height: 1px;
    background: var(--c-signal);
    transform-origin: 0 50%;
  }

  .doc__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-weight: var(--fw-display);
    font-size: var(--t-page-title);
    line-height: 0.94;
    letter-spacing: -0.032em;
    color: var(--w-95);
    text-wrap: balance;
  }

  .doc__lede-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(var(--s-6), 5vh, var(--s-8));
  }
  .doc__lede {
    margin: 0;
    max-width: 52ch;
    font-size: var(--t-lede);
    line-height: 1.5;
    color: var(--w-70);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .doc__lede-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
    .doc__lede { grid-column: 2; }
  }

  /* The hairline that closes the hero. It draws in once, then drifts a few
     pixels against the scroll — the only parallax on these pages. */
  .doc__rule {
    height: 1px;
    margin-top: clamp(var(--s-7), 8vh, var(--s-9));
    /* The outer element carries the drift, the inner line carries the draw,
       so the two transforms never fight over one property. */
    transform: translateY(var(--rule-drift, 0px));
    will-change: transform;
  }
  .doc__rule::before {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, var(--w-45), var(--w-10) 62%, transparent);
    transform-origin: 0 50%;
  }
  .reveal-on .doc__rule::before {
    transform: scaleX(0);
    animation: doc-rule-draw 0.65s var(--e-p2) 0.15s forwards;
  }
  @keyframes doc-rule-draw {
    to { transform: scaleX(1); }
  }

  /* ---- Hero figures: the numbers, set as display type ---- */
  .doc__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(196px, 100%), 1fr));
    gap: var(--s-5) var(--s-6);
    margin: var(--s-6) 0 0;
  }
  .doc__meta-item { min-width: 0; }
  .doc__meta dt {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
  }
  .doc__meta dd {
    margin: var(--s-3) 0 0;
    color: var(--w-95);
  }
  .doc__meta dd.is-signal .doc__meta-value { color: var(--c-signal); }
  .doc__meta dd.is-gold .doc__meta-value { color: var(--c-gold); }
  .doc__meta-value {
    display: block;
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-size: clamp(1.5rem, 1.05rem + 1.5vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.028em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .doc__meta-note {
    display: block;
    margin-top: var(--s-3);
    font-size: 13px;
    line-height: 1.5;
    color: var(--w-45);
    text-wrap: pretty;
  }

  /* ---- Sections ----
     Above 1080px the section index leaves the flow and becomes a rail that
     sticks alongside the section it names — the reference punctuates
     constantly, and this is the punctuation that persists. */
  .doc > section {
    position: relative;
    padding: clamp(var(--s-8), 9vh, 132px) 0;
  }
  .doc > section::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--w-25);
    transform-origin: 0 50%;
  }
  .reveal-on .doc > section::before {
    transform: scaleX(0);
    transition: transform 0.65s var(--e-p2);
  }
  .reveal-on .doc > section.is-in::before { transform: scaleX(1); }

  @media (min-width: 1080px) {
    .doc > section {
      display: grid;
      grid-template-columns: var(--rail) minmax(0, 1fr);
      column-gap: var(--s-8);
      row-gap: 0;
    }
    /* Everything but the rail sits in the reading column. */
    .doc > section > * { grid-column: 2; }
    .doc > section > .eyebrow {
      grid-column: 1;
      /* The explicit grid has no rows, so `-1` is not the last line. Spanning
         well past the content puts the rail's containing block over the whole
         section, which is what sticky needs to travel. The extra implicit
         rows are empty and the row gap is zero, so they cost no height. */
      grid-row: 1 / span 60;
      position: sticky;
      top: calc(var(--nav-h) + var(--s-6));
      align-self: start;
    }
  }

  .doc h2 {
    margin: 0 0 var(--s-6);
    max-width: 20ch;
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-weight: var(--fw-display);
    font-size: var(--t-h2);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--w-95);
    text-wrap: balance;
  }

  .doc h3 {
    margin: 0 0 var(--s-3);
    font-family: var(--f-sans);
    font-size: var(--t-h3);
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--w-95);
  }

  .doc h4 {
    margin: 0 0 var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 400;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
  }

  .doc p, .doc li { color: var(--w-85); line-height: 1.68; text-wrap: pretty; }
  .doc p { margin: 0 0 var(--s-4); max-width: var(--doc-read); }
  .doc p:last-child { margin-bottom: 0; }

  .doc a:not([class]) {
    color: var(--c-signal);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--c-signal) 45%, transparent);
  }
  .doc a:not([class]):hover { text-decoration-color: currentColor; }

  /* ---- The section marker ---- */
  .doc .eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0 0 var(--s-6);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
  }
  .doc .eyebrow__n {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    color: var(--w-70);
  }
  .doc .eyebrow__t { flex: 0 1 auto; }
  .doc .eyebrow::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background: var(--w-10);
  }

  @media (min-width: 1080px) {
    .doc .eyebrow {
      display: block;
      margin: 0;
      padding-top: 0.35em;
      transition: color 0.3s var(--e-p2);
    }
    .doc .eyebrow::after {
      display: block;
      width: 1px;
      height: clamp(28px, 4vw, 52px);
      margin-top: var(--s-4);
      background: var(--w-25);
      transform-origin: 50% 0;
      transition: transform 0.45s var(--e-p2), background 0.3s var(--e-p2);
    }
    .doc .eyebrow__n {
      display: block;
      margin-bottom: var(--s-3);
      font-size: var(--t-label);
      color: var(--w-45);
      transition: color 0.3s var(--e-p2);
    }
    .doc .eyebrow__t {
      display: block;
      max-width: 9ch;
      line-height: 1.5;
    }
    /* The rail marks the section you are actually reading. */
    .doc > section.is-current > .eyebrow { color: var(--w-70); }
    .doc > section.is-current > .eyebrow .eyebrow__n { color: var(--c-signal); }
    .doc > section.is-current > .eyebrow::after {
      background: color-mix(in srgb, var(--c-signal) 55%, transparent);
      transform: scaleY(1.6);
    }
  }

  /* ---- Body lists ---- */
  .doc ul.bullets, .doc ol.bullets {
    margin: 0 0 var(--s-4);
    padding-left: 1.1em;
    max-width: var(--doc-read);
    display: grid;
    gap: var(--s-4);
  }
  .doc ul.bullets { list-style: none; padding-left: 0; }
  .doc ul.bullets > li { position: relative; padding-left: 1.6em; }
  .doc ul.bullets > li::before {
    content: '';
    position: absolute;
    left: 0.2em;
    top: 0.66em;
    width: 10px;
    height: 1px;
    background: var(--c-signal);
  }

  /* ---- Spec list: the dt/dd rhythm the homepage fallback uses ---- */
  .doc .spec { display: grid; gap: 0; margin: 0; }
  .doc .spec > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-4) 0;
    border-top: 1px solid var(--w-10);
    transition: border-color 0.3s var(--e-p2);
  }
  .doc .spec > div:last-child { border-bottom: 1px solid var(--w-10); }
  .doc .spec > div:hover { border-top-color: var(--w-25); }
  .doc .spec dt {
    flex: 0 0 13rem;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
    line-height: 1.7;
  }
  .doc .spec dd {
    flex: 1 1 16rem;
    min-width: 0;
    margin: 0;
    color: var(--w-90);
  }
  .doc .spec dd .note { display: block; margin-top: var(--s-2); font-size: 13px; color: var(--w-45); }

  @media (max-width: 560px) {
    .doc .spec dt { flex-basis: 100%; }
  }

  /* ---- Number blocks: a ledger of display figures, not a card grid ---- */
  .doc .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 0 var(--s-6);
    margin: 0;
  }
  .doc .figures > div {
    min-width: 0;
    padding: var(--s-4) 0 var(--s-6);
    border-top: 1px solid var(--w-25);
  }
  .doc .figures dt {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
  }
  .doc .figures dd {
    margin: var(--s-4) 0 0;
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-size: var(--t-figure);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--w-95);
    overflow-wrap: anywhere;
  }
  .doc .figures dd .sub {
    display: block;
    margin-top: var(--s-3);
    font-family: var(--f-sans);
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0;
    font-variant-numeric: normal;
    color: var(--w-55);
  }
  .doc .figures dd.is-signal { color: var(--c-signal); }
  .doc .figures dd.is-gold { color: var(--c-gold); }
  .doc .figures dd.is-signal .sub,
  .doc .figures dd.is-gold .sub { color: var(--w-55); }

  /* ---- Two figures set against each other. The page's loudest moment. ---- */
  .doc .versus {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    margin: clamp(var(--s-7), 6vw, var(--s-9)) 0 0;
    padding: 0;
  }
  .doc .versus__side {
    min-width: 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--w-25);
  }
  .doc .versus__side.is-answer { border-top-color: var(--c-signal); }
  .doc .versus__label {
    margin: 0;
    max-width: none;
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
  }
  .doc .versus__value {
    margin: var(--s-5) 0 0;
    max-width: none;
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-size: var(--t-mega);
    line-height: 0.9;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    color: var(--w-95);
    overflow-wrap: anywhere;
  }
  .doc .versus__side.is-answer .versus__value { color: var(--c-signal); }
  .doc .versus__note {
    margin: var(--s-5) 0 0;
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--w-55);
  }
  @media (min-width: 720px) {
    .doc .versus { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-7); }
  }

  /* ---- Pull quote: one sentence, at the page's display scale ---- */
  .doc .pull {
    margin: clamp(var(--s-7), 6vw, var(--s-9)) 0;
    padding: 0;
    border: 0;
  }
  .doc .pull p {
    margin: 0;
    max-width: 17ch;
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-size: clamp(1.7rem, 1.05rem + 2.6vw, 3.7rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--w-95);
    text-wrap: balance;
  }
  .doc .pull p + p {
    margin-top: var(--s-5);
    max-width: 40ch;
    font-family: var(--f-sans);
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--w-55);
  }

  /* ---- Cards ---- */
  .doc .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(258px, 100%), 1fr));
    gap: var(--s-5);
  }
  .doc .card {
    position: relative;
    min-width: 0;
    padding: var(--s-5) 0 var(--s-5);
    border-top: 1px solid var(--w-25);
    transition: border-color 0.3s var(--e-p2);
  }
  .doc .card:hover { border-top-color: var(--c-signal); }
  .doc .card > :last-child { margin-bottom: 0; }
  .doc .card h3 { margin-bottom: var(--s-3); }
  .doc .card__tag {
    margin: 0 0 var(--s-4);
    color: var(--w-45);
    font-variant-numeric: tabular-nums;
  }
  .doc .card p { font-size: 14px; line-height: 1.62; color: var(--w-70); }

  /* ---- Callout: the one argument that carries the site ---- */
  .doc .callout {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-6) var(--s-6) var(--s-7);
    border-left: 1px solid var(--c-signal);
    background: linear-gradient(90deg, color-mix(in srgb, var(--c-signal) 8%, transparent), transparent 70%);
  }
  .doc .callout p { max-width: 58ch; color: var(--w-90); }
  .doc .callout strong { color: var(--w-95); }
  .doc .callout.is-warning {
