---
import {chapters,imageDisclosure} from './chapters.mjs';
const initial=chapters.manufacturing;
---
<section id="campus" class="sta-campus" aria-labelledby="sta-heading">
 <header class="sta-intro"><p class="sta-eyebrow">SMARTTEC / MEAD, OKLAHOMA</p><h2 id="sta-heading">A closer look at<br/>what comes next.</h2><p>Explore the development concept, then test the investment assumptions.</p></header>
 <div class="sta-stage" id="sta-stage">
  <img id="sta-poster" src={'/api/investor/'+initial.image} alt={initial.alt} width="1672" height="941" decoding="async"/>
  <div id="sta-canvas" hidden aria-label="Interactive concept model"></div>
  <div class="sta-topline"><span id="sta-mode" role="status">CONCEPT IMAGE</span><button id="sta-reset" type="button" hidden>Reset view</button></div>
  <div class="sta-story"><p class="sta-eyebrow" id="sta-development-status">{initial.status}</p><h3 id="sta-title">{initial.title}</h3><p id="sta-description">{initial.text}</p><p id="sta-fact">{initial.fact}</p></div>
  <p class="sta-image-disclosure" id="sta-image-disclosure">{imageDisclosure('manufacturing')}</p>
 </div>
 <div class="sta-bottom">
  <nav class="sta-chapters" aria-label="Campus chapters">{Object.entries(chapters).map(([key,c])=><button type="button" data-sta-view={key} aria-pressed={key==='manufacturing'}><span>{c.number}</span>{c.label}</button>)}</nav>
  <div class="sta-modes" role="group" aria-label="Presentation mode"><button id="sta-image" type="button" aria-pressed="true">Concept images</button><button id="sta-launch" type="button" aria-pressed="false">Explore 3D model</button></div>
 </div>
 <p id="sta-status" class="sta-status" role="status">Concept images are art direction. Choose “Explore 3D model” for a separate, simplified spatial study.</p>
 <p class="sta-disclosure">Facades, heights, interiors, access, landscaping and equipment are illustrative. Concept images are not photographs or renders of the interactive model. Nothing here establishes completed construction, engineering approval or available capacity.</p>
 <a class="sta-reference-link" href="#site-map">Open survey and satellite reference</a>
</section>
<script>import {mountCampus} from './campus-viewer.mjs'; import {mountReferencePanel} from './reference-panel.mjs'; mountCampus(); mountReferencePanel();</script>
<style>
:global(.sta-reference){background:#eaf0eb;color:#15261d}:global(.sta-reference>summary){padding:1.5rem 6vw;cursor:pointer;font-size:1rem;border-top:1px solid #15372935}:global(.sta-reference>#site-map){padding-top:3rem}
.sta-campus{padding:5rem 0 3rem;background:#12362b;color:#eef1ef;scroll-margin-top:5rem;font-family:inherit}.sta-intro{padding:0 6vw 2.5rem;display:grid;grid-template-columns:1.3fr 1fr;gap:0 5vw;align-items:end}.sta-intro .sta-eyebrow{grid-column:1/-1}.sta-intro h2{font-size:clamp(2.5rem,5.5vw,5.8rem);font-weight:500;line-height:1.02;margin:0}.sta-intro>p:last-child{font-size:1.1rem;max-width:33ch;color:#c6d4cb}.sta-eyebrow{font:0.875rem var(--f-mono,monospace);letter-spacing:.1em;line-height:1.5}.sta-stage{position:relative;min-height:650px;height:min(80vh,900px);isolation:isolate;overflow:hidden;background:#0d241c}.sta-stage>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:opacity .25s}.sta-stage:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#091d16e0,transparent 73%),linear-gradient(0deg,#0b211bf0,transparent 60%);z-index:1;pointer-events:none}.sta-stage[data-mode="model"]:after{background:linear-gradient(0deg,#0b211bdb,transparent 44%)}.sta-stage #sta-canvas{position:absolute;inset:0;z-index:0}.sta-stage :global(canvas){display:block;width:100%;height:100%;touch-action:none}.sta-topline{position:absolute;inset:1.5rem 3vw auto;display:flex;justify-content:space-between;gap:1rem;z-index:3;font:0.875rem var(--f-mono,monospace)}.sta-topline>span{background:#10291de8;border:1px solid #ffffff30;border-radius:30px;padding:.65rem 1rem;max-width:70%}.sta-topline button,.sta-modes button{font:inherit;color:inherit;border:1px solid #ffffff50;background:#10291dea;border-radius:30px;padding:.6rem 1rem;min-height:44px}.sta-story{position:absolute;bottom:4rem;left:6vw;z-index:2;max-width:min(620px,83%);pointer-events:none}.sta-story h3{font-size:clamp(2.2rem,4.8vw,5rem);font-weight:500;line-height:1.02;letter-spacing:-.04em;margin:0 0 1rem}.sta-story>p:not(.sta-eyebrow){max-width:48ch;font-size:1rem;line-height:1.6}.sta-story #sta-fact{font:0.875rem var(--f-mono,monospace);color:#a3f3b0;margin-top:1.5rem}.sta-stage[data-mode="model"] .sta-story{bottom:2.8rem}.sta-stage[data-mode="model"] .sta-story h3{font-size:1.8rem}.sta-stage[data-mode="model"] #sta-description,.sta-stage[data-mode="model"] #sta-development-status{display:none}.sta-image-disclosure{position:absolute;bottom:.5rem;left:6vw;z-index:3;font:0.75rem var(--f-mono,monospace);letter-spacing:.035em;max-width:88%;color:#e1e9e3}.sta-bottom{display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;padding:1.5rem 6vw;border-bottom:1px solid #ffffff24}.sta-chapters,.sta-modes{display:flex;gap:.65rem;flex-wrap:wrap}.sta-chapters button{background:none;color:#c6d4cb;border:0;border-bottom:2px solid transparent;padding:.9rem .8rem .9rem 0;margin-right:.8rem;font:inherit;font-size:.875rem;text-align:left;min-height:44px}.sta-chapters button span{display:block;font:0.75rem var(--f-mono,monospace);margin-bottom:.4rem;opacity:.7}.sta-chapters button[aria-pressed="true"]{border-color:#9dedab;color:#fff}.sta-modes button{font-size:.875rem}.sta-modes button[aria-pressed="true"]{background:#e9f0e9;color:#153729}.sta-status,.sta-disclosure{margin:1rem 6vw;font-size:.875rem;line-height:1.6;max-width:94ch}.sta-disclosure{color:#bfcec4}.sta-reference-link{display:inline-block;margin:1rem 6vw;min-height:44px;font-size:.875rem;text-underline-offset:5px}.sta-campus button{cursor:pointer}.sta-campus button:disabled{cursor:wait;opacity:.6}.sta-campus :focus-visible{outline:3px solid #f2b705;outline-offset:4px}@media(max-width:800px){.sta-intro{display:block}.sta-intro>p:last-child{max-width:50ch}.sta-stage{height:70svh;min-height:560px}.sta-stage>img{object-position:60% center}.sta-stage:after{background:linear-gradient(0deg,#071c16f7,transparent 95%)}.sta-story{bottom:4.5rem}.sta-bottom{gap:1rem}.sta-chapters{width:100%;justify-content:space-between;gap:.2rem}.sta-chapters button{margin:0;padding-right:.3rem;font-size:.875rem}.sta-topline{inset:1rem 5vw auto}.sta-modes{width:100%}.sta-modes button{flex:1}}@media(prefers-reduced-motion:reduce){.sta-stage>img{transition:none}}@media print{.sta-campus{background:white;color:black}.sta-stage{height:500px;min-height:0}.sta-stage #sta-canvas,.sta-bottom,.sta-topline{display:none!important}.sta-stage>img{visibility:visible!important}.sta-story{color:white}.sta-status,.sta-disclosure{color:black}}
</style>
