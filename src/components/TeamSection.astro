---
import {team} from '../data/team';
---
<section class="team-section" aria-labelledby="people" data-team-section>
  <p class="eyebrow"><span class="eyebrow__n">03</span><span class="eyebrow__t">Our team</span></p>
  <div class="team-heading">
    <div><h2 id="people">Leadership, operations and advisors</h2><p class="team-intro">The people connecting energy, technology and the delivery of SmartTec's first campus.</p></div>
    <button class="team-motion" type="button" aria-pressed="false" hidden><span aria-hidden="true">Ⅱ</span><span data-team-motion-label>Pause motion</span></button>
  </div>
  <div class="team-stage">
    <div class="team-grid">{team.map((person,index)=><article class="team-card" data-person={person.id} style={`--team-order:${index%3}`} aria-labelledby={`team-name-${person.id}`}>
      <div class="team-card-top"><span class="team-monogram" aria-hidden="true"><span>{person.initials}</span></span><span class="team-discipline">{person.discipline}</span></div>
      <div class="team-identity"><h3 id={`team-name-${person.id}`}>{person.name}</h3><p class="team-role">{person.role}</p></div>
      <div class="team-contact">
        {person.email&&<a class="team-email" href={`mailto:${person.email}`} aria-label={`Email ${person.name}: ${person.email}`}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg><span>{person.email}</span></a>}
        {person.linkedin&&<a class="team-linkedin" href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn (opens in a new tab)`}><span class="team-linkedin-icon" aria-hidden="true">in</span> LinkedIn <span aria-hidden="true">↗</span></a>}
      </div>
      <span class="team-card-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
    </article>)}</div>
  </div>
</section>
<script>import '../scripts/team-section.mjs';</script>
<style is:global>
.doc>section.team-section{display:block;isolation:isolate}.doc>.team-section>.eyebrow{position:static;margin-bottom:30px}.team-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;margin-bottom:38px}.doc .team-heading h2{font-size:clamp(2.4rem,4.5vw,4.6rem);max-width:20ch;letter-spacing:-.045em;line-height:1.04;margin:0 0 22px}.doc .team-intro{font-size:18px;line-height:1.65;max-width:60ch;margin:0;color:#bcd4c5}.team-motion{display:inline-flex;align-items:center;justify-content:center;gap:9px;flex-shrink:0;min-height:44px;padding:10px 16px;border:1px solid #a9d9b74d;border-radius:100px;background:#163d2b;color:#d4eddb;font:14px var(--f-sans);cursor:pointer;white-space:nowrap}.team-motion[hidden]{display:none}.team-motion:hover{background:#245239}.team-motion:focus-visible,.team-contact a:focus-visible{outline:2px solid #a9f6b7;outline-offset:4px}
.team-stage{position:relative;isolation:isolate;overflow:hidden;padding:22px;border:1px solid #b3e4c138;border-radius:28px;background:linear-gradient(140deg,#1b4935,#0d2b22 55%,#1d4432)}.team-stage:before{content:'';position:absolute;z-index:-1;inset:-35%;pointer-events:none;background:radial-gradient(ellipse at 35% 30%,#82f4a525,transparent 42%),radial-gradient(ellipse at 75% 80%,#b4edc018,transparent 40%);animation:team-atmosphere 26s ease-in-out infinite alternate;animation-play-state:paused}.team-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.team-card{position:relative;min-width:0;display:flex;flex-direction:column;padding:28px 24px 22px;border:1px solid #b8e8c52b;border-radius:16px;background:linear-gradient(150deg,#21553a88,#08251ee8 65%);box-shadow:0 10px 35px #041a111f;transition:transform .35s ease,border-color .35s ease,background .35s ease}.team-card:hover,.team-card:focus-within{transform:translateY(-4px);border-color:#99eca571;background:linear-gradient(150deg,#2c684697,#0b3025f2 65%)}.team-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:26px}.team-monogram{position:relative;display:grid;place-items:center;flex:0 0 68px;height:68px;border-radius:50%;background:#7be88a0b;color:#c4f6cd;font:22px var(--f-sans)}.team-monogram:before{content:'';position:absolute;inset:0;border:1px solid #b2e5c02a;border-top-color:#91eaaaab;border-right-color:#91eaaa59;border-radius:50%;animation:team-orbit 16s linear infinite;animation-delay:calc(var(--team-order)*-4s);animation-play-state:paused}.team-monogram>span{position:relative}.team-discipline{font:11px/1.5 var(--f-mono);letter-spacing:.065em;text-transform:uppercase;color:#a8ccb5;text-align:right;overflow-wrap:anywhere}.doc .team-card h3{font-size:clamp(22px,2.15vw,29px);font-weight:500;line-height:1.14;letter-spacing:-.025em;min-height:2.28em;margin:0 0 13px;color:#f0f6ee;overflow-wrap:anywhere}.doc .team-role{font-size:14px;line-height:1.5;min-height:3em;margin:0;color:#bbd3c3}.team-contact{display:grid;grid-template-rows:minmax(44px,auto) 36px;gap:7px;margin-top:23px;padding-top:18px;border-top:1px solid #b3d9bf29;min-height:106px}.doc .team-contact a{display:flex;align-items:center;gap:9px;border:0;text-decoration:none;color:#cee6d4;line-height:1.5}.doc .team-email{font:14px/1.5 var(--f-sans);min-width:0}.team-email svg{flex-shrink:0;opacity:.7}.team-email span{overflow-wrap:anywhere}.doc .team-contact a:hover{color:#a6f7b4}.doc .team-linkedin{grid-row:2;justify-self:start;font:13px/1.5 var(--f-sans);padding:4px 0}.team-linkedin-icon{display:grid;place-items:center;width:18px;height:18px;border:1px solid #a9d9b74d;border-radius:4px;font:bold 12px Arial,sans-serif}.team-card-number{position:absolute;right:24px;bottom:25px;font:11px var(--f-mono);letter-spacing:.12em;color:#7ea28c}.team-section.is-motion-active .team-stage:before,.team-section.is-motion-active .team-monogram:before{animation-play-state:running}.team-section .team-card.is-revealed{animation:team-arrive .7s both;animation-delay:calc(var(--team-order)*70ms)}
@keyframes team-atmosphere{to{transform:translate(5%,3%) rotate(8deg)}}@keyframes team-orbit{to{transform:rotate(360deg)}}@keyframes team-arrive{from{opacity:.25;translate:0 20px}to{opacity:1;translate:0 0}}
@media(max-width:1050px){.team-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.team-card{--team-order:0!important}.team-discipline{font-size:11px}.doc .team-card h3{font-size:27px}}
@media(max-width:620px){.team-heading{display:block;margin-bottom:28px}.team-motion{margin-top:22px}.doc .team-heading h2{font-size:40px}.doc .team-intro{font-size:16px}.team-stage{padding:12px;border-radius:22px}.team-grid{grid-template-columns:1fr;gap:12px}.team-card{padding:24px 22px 20px}.team-card-top{margin-bottom:23px}.doc .team-card h3{font-size:29px;min-height:0}.doc .team-role{min-height:0}.team-contact{margin-top:24px}.team-monogram{flex-basis:62px;height:62px}}
@media(prefers-reduced-motion:reduce){.team-stage:before,.team-monogram:before,.team-section .team-card.is-revealed{animation:none!important}.team-card{transition:none}.team-card:hover,.team-card:focus-within{transform:none}.team-motion{display:none}}
</style>
