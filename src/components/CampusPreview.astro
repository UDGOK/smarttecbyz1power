---
import {campusConcept} from '../data/site';
interface Props {id?:string;investor?:boolean;}
const {id='campus-experience',investor=false}=Astro.props;
const base='/assets/campus/2026-09/renders';
---
<section id={id} class:list={['campus-preview',{'campus-preview--investor':investor}]} aria-labelledby={`${id}-title`}>
  <a class="campus-preview__image" href={campusConcept.href} aria-label="Open the immersive campus experience">
    <img src={`${base}/13-hero-arrival-1600.webp`} srcset={`${base}/13-hero-arrival-1600.webp 1600w, ${base}/13-hero-arrival-2400.webp 2400w`} sizes="(max-width:760px) 100vw, 80vw" width="1600" height="900" loading="lazy" decoding="async" alt="Blender visualization of proposed Buildings A and C for compute, Building B for energy and network support, and the cooling yard" />
    <span>EXPLORE THE CAMPUS <b aria-hidden="true">↗</b></span>
  </a>
  <div class="campus-preview__copy">
    <div><p class="campus-preview__eyebrow">SITE 01 / THE CAMPUS EXPERIENCE</p><h2 id={`${id}-title`}>Step inside the plan.</h2><p>Explore 16 rendered views, move through the campus in 3D, and follow cooling, power and fiber connections. See the proposed compute halls, future energy systems and inverter manufacturing building.</p></div>
    <div><a class="campus-preview__cta" href={campusConcept.href}>Open immersive campus experience <span aria-hidden="true">↗</span></a><p class="campus-preview__note">Proposed design visualization. {campusConcept.budgetBasis}</p>{investor&&<a class="campus-preview__reference" href="#site-map">Open private survey and satellite reference ↓</a>}</div>
  </div>
</section>
<style>
.campus-preview{background:#113429;border:1px solid #89bc972f;color:#e7f0e6;margin:3rem 0 4rem;overflow:hidden;border-radius:12px;scroll-margin-top:100px}.campus-preview--investor{margin:0;border-radius:0;border-left:0;border-right:0;padding:4rem 6vw}.campus-preview__image{display:block;position:relative;overflow:hidden;background:#172b24}.campus-preview__image img{display:block;width:100%;height:auto;max-height:650px;object-fit:cover;margin:0}.campus-preview__image:after{content:'';position:absolute;inset:50% 0 0;background:linear-gradient(transparent,#081e15cc);pointer-events:none}.campus-preview__image>span{position:absolute;z-index:1;left:30px;bottom:25px;display:flex;align-items:center;gap:25px;font:12px var(--f-mono);letter-spacing:.1em;color:#fff}.campus-preview__image b{font:30px var(--f-sans);font-weight:400}.campus-preview__copy{display:grid;grid-template-columns:1.15fr 1fr;gap:40px;padding:32px}.campus-preview__eyebrow{font:10px var(--f-mono);letter-spacing:.12em;color:#9ddeaa;margin:0 0 14px}.campus-preview__copy h2{font:500 clamp(2rem,3vw,3.4rem)/1.06 var(--f-sans);letter-spacing:-.035em;margin:0 0 18px;color:#f0f5ed}.campus-preview__copy p:not(.campus-preview__eyebrow){font:15px/1.7 var(--f-sans);color:#bfd3c6;margin:0}.campus-preview__cta{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px;background:#d5ead5;color:#153b29;text-decoration:none;font:500 15px var(--f-sans);border-radius:6px;min-height:56px}.campus-preview__copy .campus-preview__note{font-size:12px;margin-top:18px;color:#adc5b5}.campus-preview__reference{display:inline-block;margin-top:18px;font-size:12px;color:#b9efc4}.campus-preview a:focus-visible{outline:3px solid #f2b705;outline-offset:-4px}@media(max-width:760px){.campus-preview__copy{grid-template-columns:1fr;gap:24px;padding:22px}.campus-preview--investor{padding:3rem 5vw}.campus-preview__image>span{left:20px;bottom:12px;font-size:10px}.campus-preview__copy p:not(.campus-preview__eyebrow){font-size:14px}.campus-preview__copy .campus-preview__note{font-size:12px}.campus-preview__cta{font-size:13px}}
</style>
