---
// Deployment configurator: five questions that size a deployment against the
// Phase 1A envelope at Site 01. Everything is server-rendered — all five
// questions, all twenty cards, the assumptions and a static fallback — and the
// script in `src/lib/configurator.ts` collapses it to one question at a time.
// With JS blocked the block still reads as a spec sheet.
import { assumptions, envelope, questions } from '../data/configurator';
import { compute, power, site } from '../data/site';

interface Props {
  /** Root element id; also namespaces the generated aria ids. */
  id?: string;
  class?: string;
  /** Where the reserve call sends people. Defaults to the capture bar. */
  ctaHref?: string;
}

const { id = 'configurator', class: className = '', ctaHref = '#reserve-form' } = Astro.props;
const pad = (n: number): string => String(n).padStart(2, '0');
---
<section
  id={id}
  class:list={['cfg', className]}
  data-configurator
  aria-labelledby={`${id}-title`}
>
  <header class="cfg__head">
    <p class="cfg__kicker mono-label">Deployment configurator · {site.designation}, {site.name}</p>
    <h2 class="cfg__title" id={`${id}-title`}>
      <span class="cfg__line"><span class="cfg__line-inner">Size your</span></span>
      <span class="cfg__line"><span class="cfg__line-inner">deployment.</span></span>
    </h2>
    <p class="cfg__lede">
      {questions.length} questions against the real envelope: {compute.systems}, {compute.gpus} GPUs
      with {compute.rentable} rentable, {power.phase1aDraw} behind a {power.transformer} transformer
      we already own. Power-on {site.powerOn}.
    </p>
  </header>

  <div class="cfg__grid">
    <div class="cfg__flow">
      <!-- Answered questions collapse into here; each chip goes back to its question. -->
      <ol class="cfg__strip" aria-label="Answers so far">
        {questions.map((q) => (
          <li class="cfg__chip-slot" data-chip-slot={q.id} hidden>
            <button type="button" class="cfg__chip" data-chip={q.id} data-cursor="action">
              <span class="cfg__chip-key mono-label">{q.chipLabel}</span>
              <span class="cfg__chip-value" data-chip-value>—</span>
            </button>
          </li>
        ))}
      </ol>

      <div class="cfg__stack">
        {questions.map((q, i) => (
          <section class="cfg__q" data-question={q.id} aria-labelledby={`${id}-${q.id}-prompt`}>
            <p class="cfg__q-kicker mono-label">
              <span class="cfg__line"><span class="cfg__line-inner">{pad(i + 1)} / {pad(questions.length)} · {q.kicker}</span></span>
            </p>
            <h3 class="cfg__q-prompt" id={`${id}-${q.id}-prompt`}>
              <span class="cfg__line"><span class="cfg__line-inner">{q.prompt}</span></span>
            </h3>
            <p class="cfg__q-help">
              <span class="cfg__line"><span class="cfg__line-inner">{q.help}</span></span>
            </p>

            <div class="cfg__cards" role="radiogroup" aria-labelledby={`${id}-${q.id}-prompt`} data-cards>
              {q.options.map((o, j) => (
                <button
                  type="button"
                  class="cfg__card"
                  role="radio"
                  aria-checked="false"
                  data-question={q.id}
                  data-option={o.id}
                  data-cursor="action"
                >
                  <span class="cfg__card-idx mono-label">{pad(j + 1)}</span>
                  <span class="cfg__card-label">{o.label}</span>
                  <span class="cfg__card-detail">{o.detail}</span>
                  <span class="cfg__card-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h13M12 5l7 7-7 7" />
                    </svg>
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))}

        <section class="cfg__result" data-result hidden aria-labelledby={`${id}-result-title`}>
          <div class="cfg__slab" data-slab>
            <div class="cfg__slab-top">
              <p class="cfg__q-kicker mono-label">
                <span class="cfg__line"><span class="cfg__line-inner">Recommendation · estimated</span></span>
              </p>
              <p class="cfg__seal mono-label" data-seal>
                <span class="cfg__verdict-dot" aria-hidden="true"></span><span data-field="fit">—</span>
              </p>
            </div>

            <h3 class="cfg__result-title" id={`${id}-result-title`} tabindex="-1" data-result-focus>
              <span class="cfg__line"><span class="cfg__line-inner" data-field="fit-headline">It fits Phase 1A.</span></span>
            </h3>
            <p class="cfg__result-detail">
              <span class="cfg__line"><span class="cfg__line-inner" data-field="fit-detail"></span></span>
            </p>

            <dl class="cfg__result-grid">
              <div class="cfg__result-cell">
                <span class="cfg__rule" data-rule aria-hidden="true"></span>
                <dt class="mono-label">GPU allocation</dt>
                <dd><strong class="cfg__figure" data-field="gpus" data-tally>—</strong> <span class="cfg__unit" data-field="gpu-note">of {compute.rentable} rentable</span></dd>
              </div>
              <div class="cfg__result-cell">
                <span class="cfg__rule" data-rule aria-hidden="true"></span>
                <dt class="mono-label">Estimated draw</dt>
                <dd><strong class="cfg__figure" data-field="kw" data-tally>—</strong> <span class="cfg__unit">kW · <span data-field="phase-share"></span></span></dd>
              </div>
              <div class="cfg__result-cell">
                <span class="cfg__rule" data-rule aria-hidden="true"></span>
                <dt class="mono-label">Transformer</dt>
                <dd><strong class="cfg__figure" data-field="share" data-tally>—</strong> <span class="cfg__unit">% of {power.transformer}</span></dd>
              </div>
              <div class="cfg__result-cell">
                <span class="cfg__rule" data-rule aria-hidden="true"></span>
                <dt class="mono-label">Energy at {power.rate}</dt>
                <dd><strong class="cfg__figure" data-field="energy" data-tally>—</strong> <span class="cfg__unit" data-field="energy-period"></span></dd>
              </div>
            </dl>

            <p class="cfg__lift mono-label" data-field="lift"></p>
            <ul class="cfg__notes" data-notes></ul>

            <div class="cfg__cta" data-reveal>
              <a class="cfg__reserve" href={ctaHref} data-cursor="action">Reserve capacity</a>
              <button type="button" class="cfg__ghost-btn cfg__ghost-btn--slab" data-restart data-cursor="action">Start over</button>
            </div>
          </div>
        </section>
      </div>

      <div class="cfg__foot">
        <button type="button" class="cfg__ghost-btn" data-cfg-back data-cursor="action">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back
        </button>
        <p class="cfg__hint mono-label" aria-hidden="true">← → move · Enter chooses · Esc goes back</p>
        <div class="cfg__pips" aria-hidden="true">
          {questions.map((q) => <span class="cfg__pip" data-pip={q.id}></span>)}
        </div>
        <p class="cfg__progress mono-label"><span data-field="progress">0 / {questions.length}</span></p>
      </div>
    </div>

    <aside class="cfg__readout" aria-label="Running estimate" data-readout>
      <span class="cfg__flash" data-flash aria-hidden="true"></span>

      <div class="cfg__readout-top">
        <p class="cfg__readout-kicker mono-label">Running estimate</p>
        <span class="cfg__delta mono-label" data-delta aria-hidden="true"></span>
      </div>

      <div class="cfg__stat">
        <span class="cfg__figure cfg__figure--lg" data-field="gpus" data-pop>—</span>
        <span class="cfg__unit">GPUs · <span data-field="gpu-note">pick a workload to start</span></span>
      </div>

      <div class="cfg__gauge">
        <div class="cfg__meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Share of the rentable Phase 1A GPUs">
          <span class="cfg__meter-ticks" aria-hidden="true"></span>
          <span class="cfg__meter-fill" data-bar></span>
          <span class="cfg__meter-mark" aria-hidden="true"></span>
        </div>
        <p class="cfg__scale mono-label" aria-hidden="true">
          <span>0</span><span>{compute.rentable} rentable</span>
        </p>
      </div>

      <dl class="cfg__stats">
        <div>
          <dt class="mono-label">Draw</dt>
          <dd><span class="cfg__figure" data-field="kw" data-pop>—</span> <span class="cfg__unit">kW</span></dd>
        </div>
        <div>
          <dt class="mono-label">{power.transformer}</dt>
          <dd><span class="cfg__figure" data-field="share" data-pop>—</span> <span class="cfg__unit">%</span></dd>
        </div>
        <div>
          <dt class="mono-label">Energy</dt>
          <dd><span class="cfg__figure" data-field="energy" data-pop>—</span> <span class="cfg__unit" data-field="energy-period">per month</span></dd>
        </div>
      </dl>

      <p class="cfg__verdict"><span class="cfg__verdict-dot" aria-hidden="true"></span><span data-field="fit">—</span></p>

      <!-- Numbers above animate; the sentence below is what gets announced. -->
      <p class="visually-hidden" role="status" aria-live="polite" data-announce></p>
    </aside>
  </div>

  <details class="cfg__assumptions">
    <summary class="mono-label">How this is worked out</summary>
    <dl>
      {assumptions.map((a) => (
        <div>
          <dt>
            {a.label}
            {a.estimated && <span class="cfg__tag mono-label">estimated</span>}
          </dt>
          <dd><strong>{a.value}</strong> — {a.source}</dd>
        </div>
      ))}
    </dl>
    <p class="cfg__smallprint">
      Figures marked estimated are not in the site record and are tuning values, not commitments.
      Everything else is derived from {envelope.systems} at {site.address}.
    </p>
  </details>

  <div class="cfg__static">
    <p class="cfg__smallprint">
      The interactive sizing needs JavaScript. The envelope it sizes against does not:
      {compute.systems}, {compute.gpus} GPUs with {compute.rentable} rentable, {power.phase1aDraw} of
      IT load, {compute.cooling.toLowerCase()}, behind a {power.transformer} transformer at
      {power.voltage} — {power.phase1aUtilisation}, {power.headroom.toLowerCase()}.
      Buildings {envelope.expansion.map((b) => b.id).join(' and ')} are {envelope.expansion[0].sqft.toLocaleString('en-US')} sqft
      shells for anything larger. <a href={ctaHref}>Reserve capacity</a> and we will size it with you.
    </p>
  </div>
</section>

<script>
  import { initConfigurator } from '../lib/configurator';
  initConfigurator();
</script>

<style>
  /* Local ladder, derived from the token alpha ramps so the whole block flips
     with the chrome the same way the rest of the UI does. The hairlines and
     shadows are mixed off `--chrome-fg-loud`, so they invert on their own. */
  .cfg {
    /* The reference's motion vocabulary. power2.out at 0.3–0.65s is its
       default gesture — 28 of the eases in its bundle — and it is what every
       resting state below is timed to. The theatrical moves (the card flight,
       the question swap) are GSAP's, and configurator.ts times those on the
       reference's osmoNav curve. Deferred to a tokens.css token the moment one
       exists. */
    --e-p2: var(--e-power2-out, cubic-bezier(0.33, 1, 0.68, 1));

    --cfg-line: var(--w-25);
    --cfg-hair: color-mix(in srgb, var(--chrome-fg-loud) 20%, transparent);
    --cfg-hair-soft: color-mix(in srgb, var(--chrome-fg-loud) 11%, transparent);
    --cfg-surface: var(--w-04);

    /* Cards float above the ground; on a dark ground they are a lit pane, on a
       light one they are paper. */
    --cfg-card: var(--w-04);
    --cfg-lift-1: 0 1px 1px color-mix(in srgb, var(--c-carbon) 24%, transparent);
    --cfg-lift-2:
      0 2px 4px color-mix(in srgb, var(--c-carbon) 20%, transparent),
      0 16px 34px color-mix(in srgb, var(--c-carbon) 26%, transparent);

    /* Chosen card: fully inverted, so the answer reads from across the room. */
    --cfg-sel-bg: var(--c-white);
    --cfg-sel-fg: var(--c-carbon);
    --cfg-sel-idx: var(--c-moss);

    /* The result slab. */
    --cfg-slab-bg: var(--w-08);
    --cfg-slab-fg: var(--w-70);
    --cfg-slab-loud: var(--w-95);
    --cfg-slab-line: var(--w-25);

    --cfg-accent: var(--c-signal);
    --cfg-dot: var(--c-signal);
    /* Overwritten from the rule data, so the gauge's threshold mark is not a
       retyped number. */
    --cfg-tight: 75%;

    position: relative;
    z-index: var(--z-content);
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--s-9) var(--s-5);
    color: var(--chrome-fg);
  }
  :global([data-chrome='dark']) .cfg {
    --cfg-line: var(--k-30);
    --cfg-surface: var(--k-06);
    --cfg-card: var(--c-white);
    --cfg-lift-1: 0 1px 2px color-mix(in srgb, var(--c-carbon) 7%, transparent), 0 6px 14px color-mix(in srgb, var(--c-carbon) 5%, transparent);
    --cfg-lift-2:
      0 2px 6px color-mix(in srgb, var(--c-carbon) 8%, transparent),
      0 18px 40px color-mix(in srgb, var(--c-carbon) 14%, transparent);
    --cfg-sel-bg: var(--c-carbon);
    --cfg-sel-fg: var(--w-95);
    --cfg-sel-idx: var(--c-signal);
    --cfg-slab-bg: var(--c-carbon);
    --cfg-accent: var(--c-moss);
  }

  /* Fit ladder: the dot always carries the colour, the type never does, so the
     verdict stays legible on either ground. */
  .cfg[data-fit='phase-1a-tight'] { --cfg-accent: var(--c-gold); --cfg-dot: var(--c-gold); }
  .cfg[data-fit='expansion']      { --cfg-accent: var(--c-power); --cfg-dot: var(--c-power); }
  :global([data-chrome='dark']) .cfg[data-fit='phase-1a-tight'] { --cfg-accent: var(--c-power-deep); }
  :global([data-chrome='dark']) .cfg[data-fit='expansion']      { --cfg-accent: var(--c-wait); --cfg-dot: var(--c-wait); }

  /* ---- Head ---- */
  .cfg__head { max-width: 62ch; margin: 0 0 var(--s-8); }
  .cfg__kicker { margin: 0 0 var(--s-4); }
  .cfg__title {
    margin: 0 0 var(--s-5);
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-weight: var(--fw-display);
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 5.6rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--chrome-fg-loud);
  }
  .cfg__lede { margin: 0; max-width: 52ch; font-size: var(--t-lede); line-height: 1.5; text-wrap: pretty; }

  /* The masked line rise, kept local: the global `.line` pair is driven by the
     stage boot script and would be reset out from under us. */
  .cfg__line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .cfg__line-inner { display: block; will-change: transform; }

  /* ---- Layout ---- */
  .cfg__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--s-7);
    align-items: start;
  }
  .cfg__flow { min-width: 0; }

  /* ---- Answered strip ---- */
  .cfg__strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0 0 var(--s-5);
    padding: 0;
    list-style: none;
  }
  .cfg__strip:empty { display: none; }
  /* Collapse the strip entirely until the first answer lands in it. */
  .cfg__strip:not(:has(.cfg__chip-slot:not([hidden]))) { display: none; }
  .cfg__chip-slot[hidden] { display: none; }
  .cfg__chip {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: 7px 14px;
    border: 1px solid var(--cfg-hair);
    border-radius: var(--r-pill);
    background: var(--cfg-card);
    box-shadow: var(--cfg-lift-1);
    color: var(--chrome-fg-loud);
    font-family: var(--f-sans);
    font-size: var(--t-ui);
    cursor: pointer;
    transition:
      border-color 0.3s var(--e-p2),
      box-shadow 0.3s var(--e-p2),
      transform 0.3s var(--e-p2);
  }
  .cfg__chip:hover, .cfg__chip:focus-visible {
    border-color: var(--chrome-fg-loud);
    box-shadow: var(--cfg-lift-2);
    transform: translateY(-2px);
  }
  .cfg__chip-key { color: var(--chrome-fg); }
  .cfg__chip-value { white-space: nowrap; }

  /* ---- Questions ---- */
  .cfg__stack { min-height: 420px; }
  .cfg__q { display: block; }
  .cfg__q[hidden], .cfg__result[hidden] { display: none; }
  .cfg__q + .cfg__q { margin-top: var(--s-8); }
  .cfg__q-kicker { margin: 0 0 var(--s-3); }
  .cfg__q-prompt {
    margin: 0 0 var(--s-4);
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-weight: var(--fw-display);
    font-size: clamp(2.3rem, 1.3rem + 3.4vw, 4.2rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--chrome-fg-loud);
    text-wrap: balance;
  }
  .cfg__q-help { margin: 0 0 var(--s-6); max-width: 48ch; font-size: var(--t-read); line-height: 1.5; }

  /* Two up, always: four options in a 2×2 block read as a set of choices, where
     an auto-fit track leaves a stranded fourth card on most widths. */
  .cfg__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  /* Single-compound selectors on `.cfg__card` itself: the fly-to-strip ghost is
     a clone appended to <body>, where descendant selectors would not reach it.
     Its children keep their own classes, so those still match. */
  .cfg__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
    min-width: 0;
    padding: var(--s-4) var(--s-4) var(--s-5);
    border: 1px solid var(--cfg-hair);
    border-radius: var(--r-card);
    background: var(--cfg-card);
    box-shadow: var(--cfg-lift-1);
    color: var(--chrome-fg-loud);
    font-family: var(--f-sans);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.3s var(--e-p2),
      box-shadow 0.3s var(--e-p2),
      transform 0.3s var(--e-p2);
  }
  /* Hover and keyboard focus get the identical lift; focus adds the ring. */
  .cfg__card:hover,
  .cfg__card:focus-visible {
    border-color: var(--chrome-fg-loud);
    box-shadow: var(--cfg-lift-2);
    transform: translateY(-5px);
  }
  .cfg__card:focus-visible {
    outline: 2px solid var(--chrome-fg-loud);
    outline-offset: 4px;
  }
  .cfg__card:active { transform: translateY(-1px) scale(0.995); }
  .cfg__card[aria-checked='true'] {
    border-color: var(--cfg-sel-bg);
    background: var(--cfg-sel-bg);
    color: var(--cfg-sel-fg);
    box-shadow: var(--cfg-lift-2);
  }

  .cfg__card-idx { color: var(--chrome-fg); transition: color 0.3s var(--e-p2); }
  .cfg__card-label { font-size: 1.35rem; line-height: 1.1; letter-spacing: -0.02em; }
  .cfg__card-detail { font-size: var(--t-ui); line-height: 1.5; color: var(--chrome-fg); }
  .cfg__card:hover .cfg__card-idx { color: var(--chrome-fg-loud); }
  .cfg__card[aria-checked='true'] .cfg__card-idx { color: var(--cfg-sel-idx); }
  .cfg__card[aria-checked='true'] .cfg__card-detail { color: var(--cfg-sel-fg); opacity: 0.72; }

  /* The consequence cue: an arrow that only exists once you are on the card. */
  .cfg__card-mark {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    display: flex;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s var(--e-p2), transform 0.45s var(--e-p2);
  }
  .cfg__card:hover .cfg__card-mark,
  .cfg__card:focus-visible .cfg__card-mark { opacity: 1; transform: translateX(0); }
  .cfg__card[aria-checked='true'] .cfg__card-mark { opacity: 1; transform: translateX(0); color: var(--cfg-sel-idx); }

  /* ---- Foot ---- */
  .cfg__foot { display: none; }
  .cfg[data-enhanced] .cfg__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--cfg-hair-soft);
  }
  .cfg__hint { margin: 0; opacity: 0.75; }
  .cfg__pips { display: flex; gap: 5px; margin-left: auto; }
  .cfg__pip {
    width: 16px;
    height: 2px;
    border-radius: var(--r-pill);
    background: var(--cfg-hair);
    transform-origin: left center;
    transition: background 0.3s var(--e-p2), transform 0.45s var(--e-p2);
  }
  .cfg__pip[data-on] { background: var(--chrome-fg-loud); }
  .cfg__pip[data-now] { background: var(--cfg-dot); transform: scaleX(1.5); }
  .cfg__progress { margin: 0; color: var(--chrome-fg-loud); font-variant-numeric: tabular-nums; }

  .cfg__ghost-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 9px 16px;
    border: 1px solid var(--cfg-line);
    border-radius: var(--r-pill);
    background: none;
    color: var(--chrome-fg-loud);
    font-family: var(--f-mono);
    font-size: var(--t-ui);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.3s var(--e-p2), background 0.3s var(--e-p2), transform 0.3s var(--e-p2);
  }
  .cfg__ghost-btn:hover { border-color: var(--chrome-fg-loud); background: var(--cfg-surface); transform: translateY(-1px); }

  /* ---- Readout: the instrument panel ---- */
  .cfg__readout {
    position: sticky;
    top: calc(var(--chrome-inset) * 5);
    overflow: hidden;
    padding: var(--s-5);
    border: 1px solid var(--cfg-hair);
    border-radius: var(--r-card);
    background: var(--cfg-card);
    box-shadow: var(--cfg-lift-1);
  }
  /* Fires on a material change; opacity only, so it costs nothing. */
  .cfg__flash {
    position: absolute;
    inset: 0;
    background: var(--cfg-accent);
    opacity: 0;
    pointer-events: none;
  }
  .cfg__readout-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin: 0 0 var(--s-5);
    min-height: 20px;
  }
  .cfg__readout-kicker { margin: 0; }
  .cfg__delta {
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: var(--cfg-dot);
