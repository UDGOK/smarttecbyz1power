---
// Deployment configurator: five questions that size a deployment against the
// Phase 1A envelope at Site 01. Everything is server-rendered — all five
// questions, all twenty cards, the assumptions and a static fallback — and the
// script in `src/lib/configurator.ts` collapses it to one question at a time.
// With JS blocked the block still reads as a spec sheet.
import { assumptions, envelope, questions } from '../data/configurator';
import { compute, power, site } from '../data/site';

interface Props {
  /** Root element id; also namespaces the generated aria ids. */
  id?: string;
  class?: string;
  /** Where the reserve call sends people. Defaults to the capture bar. */
  ctaHref?: string;
}

const { id = 'configurator', class: className = '', ctaHref = '#reserve-form' } = Astro.props;
const pad = (n: number): string => String(n).padStart(2, '0');
---
<section
  id={id}
  class:list={['cfg', className]}
  data-configurator
  aria-labelledby={`${id}-title`}
>
  <header class="cfg__head">
    <p class="cfg__kicker mono-label">Deployment configurator · {site.designation}, {site.name}</p>
    <h2 class="cfg__title" id={`${id}-title`}>
      <span class="cfg__line"><span class="cfg__line-inner">Size your</span></span>
      <span class="cfg__line"><span class="cfg__line-inner">deployment.</span></span>
    </h2>
    <p class="cfg__lede">
      {questions.length} questions against the real envelope: {compute.systems}, {compute.gpus} GPUs
      with {compute.rentable} rentable, {power.phase1aDraw} behind a {power.transformer} transformer
      we already own. Power-on {site.powerOn}.
    </p>
  </header>

  <div class="cfg__grid">
    <div class="cfg__flow">
      <!-- Answered questions collapse into here; each chip goes back to its question. -->
      <ol class="cfg__strip" aria-label="Answers so far">
        {questions.map((q) => (
          <li class="cfg__chip-slot" data-chip-slot={q.id} hidden>
            <button type="button" class="cfg__chip" data-chip={q.id} data-cursor="action">
              <span class="cfg__chip-key mono-label">{q.chipLabel}</span>
              <span class="cfg__chip-value" data-chip-value>—</span>
            </button>
          </li>
        ))}
      </ol>

      <div class="cfg__stack">
        {questions.map((q, i) => (
          <section class="cfg__q" data-question={q.id} aria-labelledby={`${id}-${q.id}-prompt`}>
            <p class="cfg__q-kicker mono-label">
              <span class="cfg__line"><span class="cfg__line-inner">{pad(i + 1)} / {pad(questions.length)} · {q.kicker}</span></span>
            </p>
            <h3 class="cfg__q-prompt" id={`${id}-${q.id}-prompt`}>
              <span class="cfg__line"><span class="cfg__line-inner">{q.prompt}</span></span>
            </h3>
            <p class="cfg__q-help">
              <span class="cfg__line"><span class="cfg__line-inner">{q.help}</span></span>
            </p>

            <div class="cfg__cards" role="radiogroup" aria-labelledby={`${id}-${q.id}-prompt`} data-cards>
              {q.options.map((o, j) => (
                <button
                  type="button"
                  class="cfg__card"
                  role="radio"
                  aria-checked="false"
                  data-question={q.id}
                  data-option={o.id}
                  data-cursor="action"
                >
                  <span class="cfg__card-idx mono-label">{pad(j + 1)}</span>
                  <span class="cfg__card-label">{o.label}</span>
                  <span class="cfg__card-detail">{o.detail}</span>
                </button>
              ))}
            </div>
          </section>
        ))}

        <section class="cfg__result" data-result hidden aria-labelledby={`${id}-result-title`}>
          <p class="cfg__q-kicker mono-label">
            <span class="cfg__line"><span class="cfg__line-inner">Recommendation · estimated</span></span>
          </p>
          <h3 class="cfg__result-title" id={`${id}-result-title`} tabindex="-1" data-result-focus>
            <span class="cfg__line"><span class="cfg__line-inner" data-field="fit-headline">It fits Phase 1A.</span></span>
          </h3>
          <p class="cfg__result-detail">
            <span class="cfg__line"><span class="cfg__line-inner" data-field="fit-detail"></span></span>
          </p>

          <dl class="cfg__result-grid">
            <div class="cfg__result-cell" data-reveal>
              <dt class="mono-label">GPU allocation</dt>
              <dd><strong class="cfg__figure" data-field="gpus">—</strong> <span class="cfg__unit" data-field="gpu-note">of {compute.rentable} rentable</span></dd>
            </div>
            <div class="cfg__result-cell" data-reveal>
              <dt class="mono-label">Estimated draw</dt>
              <dd><strong class="cfg__figure" data-field="kw">—</strong> <span class="cfg__unit">kW · <span data-field="phase-share"></span></span></dd>
            </div>
            <div class="cfg__result-cell" data-reveal>
              <dt class="mono-label">Transformer</dt>
              <dd><strong class="cfg__figure" data-field="share">—</strong> <span class="cfg__unit">% of {power.transformer}</span></dd>
            </div>
            <div class="cfg__result-cell" data-reveal>
              <dt class="mono-label">Energy at {power.rate}</dt>
              <dd><strong class="cfg__figure" data-field="energy">—</strong> <span class="cfg__unit" data-field="energy-period"></span></dd>
            </div>
          </dl>

          <p class="cfg__lift mono-label" data-field="lift"></p>
          <ul class="cfg__notes" data-notes></ul>

          <div class="cfg__cta" data-reveal>
            <a class="cfg__reserve" href={ctaHref} data-cursor="action">Reserve capacity</a>
            <button type="button" class="cfg__ghost-btn" data-restart data-cursor="action">Start over</button>
          </div>
        </section>
      </div>

      <div class="cfg__foot">
        <button type="button" class="cfg__ghost-btn" data-cfg-back data-cursor="action">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back
        </button>
        <p class="cfg__hint mono-label" aria-hidden="true">← → move · Enter chooses · Esc goes back</p>
        <p class="cfg__progress mono-label"><span data-field="progress">0 / {questions.length}</span></p>
      </div>
    </div>

    <aside class="cfg__readout" aria-label="Running estimate">
      <p class="cfg__readout-kicker mono-label">Running estimate</p>

      <div class="cfg__stat">
        <span class="cfg__figure cfg__figure--lg" data-field="gpus">—</span>
        <span class="cfg__unit">GPUs · <span data-field="gpu-note">pick a workload to start</span></span>
      </div>

      <div class="cfg__meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Share of the rentable Phase 1A GPUs">
        <span class="cfg__meter-fill" data-bar></span>
      </div>

      <dl class="cfg__stats">
        <div>
          <dt class="mono-label">Draw</dt>
          <dd><span class="cfg__figure" data-field="kw">—</span> <span class="cfg__unit">kW</span></dd>
        </div>
        <div>
          <dt class="mono-label">{power.transformer}</dt>
          <dd><span class="cfg__figure" data-field="share">—</span> <span class="cfg__unit">%</span></dd>
        </div>
        <div>
          <dt class="mono-label">Energy</dt>
          <dd><span class="cfg__figure" data-field="energy">—</span> <span class="cfg__unit" data-field="energy-period">per month</span></dd>
        </div>
      </dl>

      <p class="cfg__verdict"><span class="cfg__verdict-dot" aria-hidden="true"></span><span data-field="fit">—</span></p>

      <!-- Numbers above animate; the sentence below is what gets announced. -->
      <p class="visually-hidden" role="status" aria-live="polite" data-announce></p>
    </aside>
  </div>

  <details class="cfg__assumptions">
    <summary class="mono-label">How this is worked out</summary>
    <dl>
      {assumptions.map((a) => (
        <div>
          <dt>
            {a.label}
            {a.estimated && <span class="cfg__tag mono-label">estimated</span>}
          </dt>
          <dd><strong>{a.value}</strong> — {a.source}</dd>
        </div>
      ))}
    </dl>
    <p class="cfg__smallprint">
      Figures marked estimated are not in the site record and are tuning values, not commitments.
      Everything else is derived from {envelope.systems} at {site.address}.
    </p>
  </details>

  <div class="cfg__static">
    <p class="cfg__smallprint">
      The interactive sizing needs JavaScript. The envelope it sizes against does not:
      {compute.systems}, {compute.gpus} GPUs with {compute.rentable} rentable, {power.phase1aDraw} of
      IT load, {compute.cooling.toLowerCase()}, behind a {power.transformer} transformer at
      {power.voltage} — {power.phase1aUtilisation}, {power.headroom.toLowerCase()}.
      Buildings {envelope.expansion.map((b) => b.id).join(' and ')} are {envelope.expansion[0].sqft.toLocaleString('en-US')} sqft
      shells for anything larger. <a href={ctaHref}>Reserve capacity</a> and we will size it with you.
    </p>
  </div>
</section>

<script>
  import { initConfigurator } from '../lib/configurator';
  initConfigurator();
</script>

<style>
  /* Local ladder, derived from the token alpha ramps so the whole block flips
     with the chrome the same way the rest of the UI does. */
  .cfg {
    --cfg-line: var(--w-25);
    --cfg-line-soft: var(--w-10);
    --cfg-surface: var(--w-04);
    --cfg-surface-hi: var(--w-08);
    --cfg-accent: var(--c-signal);

    position: relative;
    z-index: var(--z-content);
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--s-9) var(--s-5);
    color: var(--chrome-fg);
  }
  :global([data-chrome='dark']) .cfg {
    --cfg-line: var(--k-30);
    --cfg-line-soft: var(--k-06);
    --cfg-surface: var(--k-06);
    --cfg-surface-hi: var(--k-06);
  }
  .cfg[data-fit='phase-1a-tight'] { --cfg-accent: var(--c-gold); }
  .cfg[data-fit='expansion']      { --cfg-accent: var(--c-power); }

  /* ---- Head ---- */
  .cfg__head { max-width: 62ch; margin: 0 0 var(--s-8); }
  .cfg__kicker { margin: 0 0 var(--s-4); }
  .cfg__title {
    margin: 0 0 var(--s-5);
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: clamp(2.2rem, 1.2rem + 3.4vw, 4.2rem);
    line-height: 0.94;
    letter-spacing: -0.025em;
    color: var(--chrome-fg-loud);
  }
  .cfg__lede { margin: 0; max-width: 52ch; font-size: var(--t-lede); line-height: 1.5; text-wrap: pretty; }

  /* The masked line rise, kept local: the global `.line` pair is driven by the
     stage boot script and would be reset out from under us. */
  .cfg__line { display: block; overflow: hidden; }
  .cfg__line-inner { display: block; will-change: transform; }

  /* ---- Layout ---- */
  .cfg__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--s-7);
    align-items: start;
  }
  .cfg__flow { min-width: 0; }

  /* ---- Answered strip ---- */
  .cfg__strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0 0 var(--s-5);
    padding: 0;
    list-style: none;
  }
  .cfg__strip:empty { display: none; }
  /* Collapse the strip entirely until the first answer lands in it. */
  .cfg__strip:not(:has(.cfg__chip-slot:not([hidden]))) { display: none; }
  .cfg__chip-slot[hidden] { display: none; }
  .cfg__chip {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: 7px 13px;
    border: 1px solid var(--cfg-line-soft);
    border-radius: var(--r-pill);
    background: var(--cfg-surface);
    color: var(--chrome-fg-loud);
    font-family: var(--f-sans);
    font-size: var(--t-ui);
    cursor: pointer;
    transition: border-color var(--d-fast), background var(--d-fast), transform var(--d-fast) var(--e-out);
  }
  .cfg__chip:hover, .cfg__chip:focus-visible {
    border-color: var(--cfg-accent);
    background: var(--cfg-surface-hi);
    transform: translateY(-1px);
  }
  .cfg__chip-key { color: var(--chrome-fg); }
  .cfg__chip-value { white-space: nowrap; }

  /* ---- Questions ---- */
  .cfg__stack { min-height: 340px; }
  .cfg__q { display: block; }
  .cfg__q[hidden], .cfg__result[hidden] { display: none; }
  .cfg__q + .cfg__q { margin-top: var(--s-8); }
  .cfg__q-kicker { margin: 0 0 var(--s-3); }
  .cfg__q-prompt {
    margin: 0 0 var(--s-3);
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 1.1rem + 2vw, 2.8rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--chrome-fg-loud);
  }
  .cfg__q-help { margin: 0 0 var(--s-5); max-width: 48ch; font-size: var(--t-read); }

  .cfg__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--s-3);
  }

  /* Single-compound selectors: the fly-to-strip ghost is a clone of this card
     appended to <body>, and descendant selectors would not reach it there. */
  .cfg__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
    min-width: 0;
    padding: var(--s-4);
    border: 1px solid var(--cfg-line-soft);
    border-radius: var(--r-card);
    background: var(--cfg-surface);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--chrome-fg-loud);
    font-family: var(--f-sans);
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--d-fast),
      background var(--d-fast),
      transform var(--d-fast) var(--e-out);
  }
  /* Hover and keyboard focus get the identical treatment. */
  .cfg__card:hover,
  .cfg__card:focus-visible {
    border-color: var(--cfg-accent);
    background: var(--cfg-surface-hi);
    transform: translateY(-3px);
  }
  .cfg__card[aria-checked='true'] {
    border-color: var(--cfg-accent);
    box-shadow: inset 0 0 0 1px var(--cfg-accent);
  }
  .cfg__card-idx { color: var(--chrome-fg); }
  .cfg__card[aria-checked='true'] .cfg__card-idx { color: var(--cfg-accent); }
  .cfg__card-label { font-size: 1.15rem; line-height: 1.15; letter-spacing: -0.01em; }
  .cfg__card-detail { font-size: var(--t-ui); line-height: 1.45; color: var(--chrome-fg); }

  /* ---- Foot ---- */
  .cfg__foot { display: none; }
  .cfg[data-enhanced] .cfg__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--cfg-line-soft);
  }
  .cfg__hint { margin: 0; opacity: 0.75; }
  .cfg__progress { margin: 0 0 0 auto; color: var(--chrome-fg-loud); font-variant-numeric: tabular-nums; }

  .cfg__ghost-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 8px 15px;
    border: 1px solid var(--cfg-line);
    border-radius: var(--r-pill);
    background: none;
    color: var(--chrome-fg-loud);
    font-family: var(--f-mono);
    font-size: var(--t-ui);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--d-fast), background var(--d-fast);
  }
  .cfg__ghost-btn:hover { border-color: var(--cfg-accent); background: var(--cfg-surface); }

  /* ---- Readout ---- */
  .cfg__readout {
    position: sticky;
    top: calc(var(--chrome-inset) * 5);
    padding: var(--s-5);
    border: 1px solid var(--cfg-line-soft);
    border-radius: var(--r-card);
    background: var(--cfg-surface);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .cfg__readout-kicker { margin: 0 0 var(--s-4); }
  .cfg__stat { display: flex; flex-direction: column; gap: var(--s-1); }
  .cfg__figure {
    font-family: var(--f-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--chrome-fg-loud);
  }
  .cfg__figure--lg { font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.4rem); line-height: 1; letter-spacing: -0.03em; }
  .cfg__unit { font-family: var(--f-mono); font-size: var(--t-label); letter-spacing: var(--ls-mid); color: var(--chrome-fg); }

  .cfg__meter {
    height: 3px;
    margin: var(--s-4) 0 var(--s-5);
    border-radius: var(--r-pill);
    background: var(--cfg-line-soft);
    overflow: hidden;
  }
  .cfg__meter-fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--cfg-accent);
  }

  .cfg__stats { display: grid; gap: var(--s-3); margin: 0; }
  .cfg__stats > div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .cfg__stats dt { margin: 0; }
  .cfg__stats dd { margin: 0; text-align: right; }

  .cfg__verdict {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: var(--s-5) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--cfg-line-soft);
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: var(--ls-mid);
    text-transform: uppercase;
    color: var(--chrome-fg-loud);
  }
  .cfg__verdict-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cfg-accent); flex: 0 0 auto; }

  /* ---- Result ---- */
  .cfg__result-title {
    margin: 0 0 var(--s-4);
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 1.2rem + 2.2vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--chrome-fg-loud);
  }
  .cfg__result-title:focus-visible { outline-offset: 6px; }
  .cfg__result-detail { margin: 0 0 var(--s-6); max-width: 56ch; font-size: var(--t-read); text-wrap: pretty; }

  .cfg__result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-5);
  }
  .cfg__result-cell {
    min-width: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--cfg-line);
  }
  .cfg__result-cell dt { margin: 0 0 var(--s-2); }
  .cfg__result-cell dd { margin: 0; display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap; }
  .cfg__result-cell .cfg__figure { font-size: 1.8rem; letter-spacing: -0.02em; }

  .cfg__lift { margin: 0 0 var(--s-4); color: var(--cfg-accent); }
  .cfg__lift:empty { display: none; }
  .cfg__notes { margin: 0 0 var(--s-6); padding: 0; list-style: none; display: grid; gap: var(--s-2); }
  .cfg__notes:empty { display: none; }
  .cfg__note { padding-left: var(--s-4); font-size: var(--t-ui); line-height: 1.5; position: relative; }
  .cfg__note::before { content: '—'; position: absolute; left: 0; color: var(--chrome-fg); }

  .cfg__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .cfg__reserve {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    border-radius: var(--r-pill);
    background: var(--cfg-accent);
    color: var(--c-carbon);
    font-family: var(--f-mono);
    font-size: var(--t-ui);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--d-fast) var(--e-out), filter var(--d-fast);
  }
  .cfg__reserve:hover { transform: translateY(-2px); filter: brightness(1.08); }

  /* ---- Assumptions + fallback ---- */
  .cfg__assumptions {
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--cfg-line-soft);
  }
  .cfg__assumptions summary { cursor: pointer; color: var(--chrome-fg-loud); }
  .cfg__assumptions dl { display: grid; gap: var(--s-3); margin: var(--s-5) 0 0; }
  .cfg__assumptions dl > div { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: var(--s-4); }
  .cfg__assumptions dt {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2);
    font-family: var(--f-mono); font-size: var(--t-label);
    letter-spacing: var(--ls-mid); text-transform: uppercase; color: var(--chrome-fg);
  }
  .cfg__assumptions dd { margin: 0; font-size: var(--t-ui); line-height: 1.5; }
  .cfg__assumptions dd strong { color: var(--chrome-fg-loud); }
  .cfg__tag {
    padding: 2px 7px;
    border: 1px solid var(--cfg-accent);
    border-radius: var(--r-pill);
    color: var(--cfg-accent);
  }
  .cfg__smallprint { margin: var(--s-5) 0 0; font-size: var(--t-ui); line-height: 1.6; color: var(--chrome-fg); }
  .cfg__static { margin-top: var(--s-5); }
  .cfg[data-enhanced] .cfg__static { display: none; }

  /* ---- Responsive: one column, readout first, nothing wider than the page ---- */
  @media (max-width: 900px) {
    .cfg__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .cfg__readout { position: static; order: -1; }
    .cfg__stack { min-height: 0; }
  }
  @media (max-width: 640px) {
    .cfg { padding: var(--s-8) var(--s-4); }
    .cfg__cards { grid-template-columns: minmax(0, 1fr); }
    .cfg__result-grid { grid-template-columns: minmax(0, 1fr); }
    .cfg__assumptions dl > div { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
    .cfg__hint { display: none; }
  }

  /* Reduced motion: the script already swaps instantly and jumps the counter.
     This kills the hover lift so nothing moves under the pointer either. */
  @media (prefers-reduced-motion: reduce) {
    .cfg__card:hover, .cfg__card:focus-visible, .cfg__chip:hover, .cfg__reserve:hover { transform: none; }
  }
</style>
