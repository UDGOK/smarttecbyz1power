---
import type {PageExperience} from '../data/page-experiences';
import CinematicArt from './CinematicArt.astro';
import {visualStory} from '../data/cinematic';
import {campusConcept} from '../data/site';
interface Props { experience:PageExperience; immersive?:boolean; }
const {experience:e,immersive=false}=Astro.props;
const id='page-scene-'+e.kind;
const story=visualStory(e.path);
---
{e.kind==='campus'?<figure class:list={["page-scene","page-scene--campus",immersive&&"page-scene--backdrop"]} aria-labelledby={id+'-title'}>
  <div class="page-scene__top"><span>SMARTTEC / BLENDER SPATIAL STUDY</span><span class="page-scene__badge">CAMPUS EXPLORER</span></div>
  <div class="page-scene__viewport">
    <div class="page-scene__fallback"><CinematicArt path={e.path} instance="scene" eager={!e.compact} /></div>
    <div class="page-scene__entry"><a class="page-scene__campus-link" href={campusConcept.href}>Explore in 3D <span aria-hidden="true">↗</span></a></div>
  </div>
  <figcaption class="page-scene__caption">
    <h2 id={id+'-title'}>{e.sceneTitle}</h2>
    <p class="page-scene__art-note">{story.note}</p>
    <p class="page-scene__disclosure">{e.sceneNote}</p>
  </figcaption>
</figure>:<figure class:list={["page-scene",immersive&&"page-scene--backdrop"]} data-page-scene data-scene-kind={e.kind} data-scene-compact={String(e.compact)} aria-labelledby={id+'-title'}>
  <div class="page-scene__top"><span>SMARTTEC / SPATIAL CONCEPT</span><span class="page-scene__badge" data-scene-badge>3D EXPLORER</span></div>
  <div class="page-scene__viewport">
    <div class="page-scene__fallback" data-scene-fallback><CinematicArt path={e.path} instance="scene" eager={!e.compact} /></div>
    <div class="page-scene__canvas" data-scene-host></div>
    <div class="page-scene__entry"><button type="button" data-scene-launch>Explore in 3D <span aria-hidden="true">↗</span></button></div>
  </div>
  <figcaption class="page-scene__caption">
    <h2 id={id+'-title'}>{e.sceneTitle}</h2>
    <p class="page-scene__art-note">{story.note}</p>
    <p data-scene-status role="status">Choose a topic, or open the 3D model.</p>
    <div class="page-scene__controls" data-scene-controls hidden>
      <details class="page-scene__tools"><summary>Scene controls</summary><div class="page-scene__tools-content">
      <label class="page-scene__range"><span>{e.viewLabel}</span><input type="range" min="0" max="100" value="28" step="1" data-scene-position aria-label={e.viewLabel}/></label>
      <div class="page-scene__buttons"><button type="button" data-scene-action="reset">Reset view</button><button type="button" data-scene-action="play" aria-pressed="false">Play motion</button><button type="button" data-scene-action="close">Close 3D</button></div>
      </div></details>
    </div>
    <p class="page-scene__disclosure">{e.sceneNote}</p>
  </figcaption>
  <noscript><p>Interactive 3D needs JavaScript. All project information is available below.</p></noscript>
</figure>}
<script>
if(document.querySelector('[data-page-scene]')){
  const {mountPageScenes}=await import('../lib/public-scene/controller.mjs');
  mountPageScenes();
}
</script>
