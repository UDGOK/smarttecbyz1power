---
/**
 * Primary navigation for the content routes.
 *
 * The cinematic route has its own fixed chrome (Brandmark / ScrollRuler /
 * PowerBadge) and deliberately does not use this. These are reading pages, so
 * the nav is a real sticky <header> with a real <nav> landmark, and the current
 * page is marked with aria-current.
 *
 * It borrows two things from the cinematic chrome so the two layers read as one
 * site: a mono status line carrying the site's live figures, and a hairline
 * that reports scroll position the way the stage ruler does. On the way down it
 * condenses to a single line of marks; on the way up it opens again. With no
 * JavaScript it simply stays open, which is the same nav minus the compression.
 *
 * Below ~760px the link strip scrolls inside itself rather than wrapping into a
 * second row or pushing the page wider than the viewport.
 */
import { company, site, power } from '../data/site';

const links = [
  { href: '/site', label: 'Site 01' },
  { href: '/power', label: 'Power' },
  { href: '/colocation', label: 'Colocation' },
  { href: '/compute', label: 'Compute' },
  { href: '/about', label: 'About' },
] as const;

/** Astro serves /site in dev and /site/ from the directory build. Normalise. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <svg class="nav__mark" viewBox="0 0 40 40" width="26" height="26" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
        <path d="M12 14h16l-11 12h11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="nav__wordmark">
        {company.name}<span class="nav__parent"> by {company.parent}</span>
      </span>
    </a>

    <p class="nav__status" aria-hidden="true">
      <span class="nav__dot"></span>
      <span class="nav__status-text">{power.transformer} · {site.powerOn}</span>
    </p>

    <nav class="nav__nav" aria-label="Primary">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a
              class="nav__link"
              href={l.href}
              aria-current={path === l.href ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
        <li>
          <a
            class="nav__link nav__link--cta"
            href="/contact"
            aria-current={path === '/contact' ? 'page' : undefined}
          >Contact</a>
        </li>
      </ul>
    </nav>
  </div>

  <span class="nav__progress" data-nav-progress aria-hidden="true"></span>
</header>

<style>
  .nav {
    /* Timing follows the reference: power2.out — `--e-p2` from the shared
       motion vocabulary in chrome.css — at 0.3–0.65s. The expo-grade
       `--e-out`/`--d-*` pairing this nav used to run on is what read as snappy.
       See content-motion.ts for the damped half of the condense. */
    position: sticky;
    top: 0;
    z-index: var(--z-chrome);
    background: color-mix(in srgb, var(--c-land-deep) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    transition: background 0.3s var(--e-p2);
  }
  /* Off the top of the page the nav is a floating strip with no edge; the
     moment the page moves under it, it grows one. `--nav-condense` and
     `--nav-lift` are both damped per frame by content-motion.ts, so this edge
     arrives continuously rather than being switched on at a threshold. With
     the module absent the properties are simply unset and the nav sits open,
     which is the same nav minus the compression. */
  .nav::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--w-10);
    opacity: var(--nav-lift, 0);
  }
  .nav.is-scrolled { background: color-mix(in srgb, var(--c-land-deep) 92%, transparent); }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: var(--s-4) var(--s-4);
    transition: padding 0.45s var(--e-p2), gap 0.45s var(--e-p2);
  }
  .nav.is-condensed .nav__inner { padding-top: var(--s-2); padding-bottom: var(--s-2); }

  .nav__brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--w-95);
    text-decoration: none;
  }
  .nav__mark { transition: transform 0.3s var(--e-p2); }
  .nav__brand:hover .nav__mark { transform: rotate(-8deg) scale(1.06); }

  .nav__wordmark {
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav__parent { color: var(--w-45); }

  /* The one live line the cinematic chrome always carries, restated. */
  .nav__status {
    flex: 0 1 auto;
    display: none;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    padding-left: var(--s-5);
    border-left: 1px solid var(--w-10);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* The continuous half of the condense: the live line thins out as the bar
       closes, on the damped scalar rather than on a class. */
    opacity: calc(1 - 0.7 * var(--nav-condense, 0));
  }
  .nav__dot {
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-signal) 16%, transparent);
  }

  .nav__nav {
    flex: 1 1 auto;
    min-width: 0;
    /* The strip, not the page, takes the overflow. */
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .nav__nav::-webkit-scrollbar { display: none; }

  .nav__list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: block;
    padding: var(--s-2) var(--s-1);
    color: var(--w-55);
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: var(--ls-mid);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s var(--e-p2);
  }
  /* A hairline that grows out of the baseline rather than a pill. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: var(--s-1);
    right: var(--s-1);
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.45s var(--e-p2);
  }
  .nav__link:hover { color: var(--w-95); }
  .nav__link:hover::after { transform: scaleX(1); }
  .nav__link[aria-current='page'] { color: var(--c-signal); }
  .nav__link[aria-current='page']::after { transform: scaleX(1); }

  /* Contact is the conversion surface, so it is drawn as one. */
  .nav__link--cta {
    margin-left: var(--s-3);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--w-25);
    border-radius: var(--r-pill);
    color: var(--w-95);
    transition: color 0.3s var(--e-p2), border-color 0.3s var(--e-p2), background 0.3s var(--e-p2);
  }
  .nav__link--cta::after { display: none; }
  .nav__link--cta:hover { border-color: var(--c-signal); background: color-mix(in srgb, var(--c-signal) 12%, transparent); }
  .nav__link--cta[aria-current='page'] {
    border-color: var(--c-signal);
    background: color-mix(in srgb, var(--c-signal) 14%, transparent);
    color: var(--c-signal);
  }

  /* Scroll position, drawn the way the stage ruler draws it. */
  .nav__progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--c-signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (min-width: 1080px) {
    .nav__status { display: flex; }
  }

  @media (max-width: 760px) {
    .nav__inner { flex-direction: column; align-items: stretch; gap: var(--s-3); }
    .nav.is-condensed .nav__inner { gap: var(--s-2); }
    .nav__list { justify-content: flex-start; }
    /* Bleed the strip to the screen edges so it reads as scrollable. */
    .nav__nav { margin: 0 calc(var(--s-4) * -1); padding: 0 var(--s-4) 2px; }
  }

  @media (max-width: 400px) {
    .nav__parent { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after { transition: none; }
    .nav__inner { transition: none; }
  }
</style>
