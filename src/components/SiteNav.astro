---
/**
 * Primary navigation for the content routes.
 *
 * The links used to sit here as a horizontal strip. At five it was tight, at
 * six it overflowed and scrolled inside itself, and a strip that has to scroll
 * is a strip nobody reads to the end of. They live in the full-screen menu now
 * — the same one the cinematic route opens — and what stays here is the brand,
 * the live status line and the control that opens it.
 *
 * The cinematic route has its own fixed chrome (Brandmark / ScrollRuler /
 * PowerBadge) and deliberately does not use this. These are reading pages, so
 * the nav is a real sticky <header> with a real <nav> landmark, and the current
 * page is marked with aria-current.
 *
 * It borrows two things from the cinematic chrome so the two layers read as one
 * site: a mono status line carrying the site's live figures, and a hairline
 * that reports scroll position the way the stage ruler does. On the way down it
 * condenses to a single line of marks; on the way up it opens again. With no
 * JavaScript it simply stays open, which is the same nav minus the compression.
 */
import { company, site, power } from '../data/site';
import SiteMenu from './chrome/SiteMenu.astro';

/** Astro serves /site in dev and /site/ from the directory build. Normalise. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {/* The wordmark as artwork rather than type. These pages are always on
          the dark ground, so the off-white variant is the only one needed, and
          one cached SVG beats inlining 14KB of curves into all six routes.
          "by Z1Power" stays typed in the UI mono: at this size the lockup's
          own endorsement would set at about four pixels, which is the case the
          kit says to use the plain wordmark for. */}
      <img
        class="nav__mark"
        src="/assets/brand/smarttec-wordmark-offwhite-green.svg"
        alt={company.name}
        width="126"
        height="22"
        decoding="async"
      />
      <span class="nav__wordmark">
        <span class="nav__parent">by {company.parent}</span>
      </span>
    </a>

    <p class="nav__status" aria-hidden="true">
      <span class="nav__dot"></span>
      <span class="nav__status-text">{power.voltage} · {site.powerOn}</span>
    </p>

    <SiteMenu part="toggle" />
  </div>

  <span class="nav__progress" data-nav-progress aria-hidden="true"></span>
</header>

<style>
  .nav {
    /* Timing follows the reference: power2.out — `--e-p2` from the shared
       motion vocabulary in chrome.css — at 0.3–0.65s. The expo-grade
       `--e-out`/`--d-*` pairing this nav used to run on is what read as snappy.
       See content-motion.ts for the damped half of the condense. */
    position: sticky;
    top: 0;
    z-index: var(--z-chrome);
    background: color-mix(in srgb, var(--c-land-deep) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    transition: background 0.3s var(--e-p2);
  }
  /* Off the top of the page the nav is a floating strip with no edge; the
     moment the page moves under it, it grows one. `--nav-condense` and
     `--nav-lift` are both damped per frame by content-motion.ts, so this edge
     arrives continuously rather than being switched on at a threshold. With
     the module absent the properties are simply unset and the nav sits open,
     which is the same nav minus the compression. */
  .nav::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--w-10);
    opacity: var(--nav-lift, 0);
  }
  .nav.is-scrolled { background: color-mix(in srgb, var(--c-land-deep) 92%, transparent); }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: var(--s-4) var(--s-4);
    transition: padding 0.45s var(--e-p2), gap 0.45s var(--e-p2);
  }
  .nav.is-condensed .nav__inner { padding-top: var(--s-2); padding-bottom: var(--s-2); }

  .nav__brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--w-95);
    text-decoration: none;
  }
  /* Height-locked; width follows the artwork's own 1231:215 ratio so the
     proportions stay exactly as drawn. */
  .nav__mark {
    display: block;
    width: auto;
    height: 22px;
    transition: opacity 0.3s var(--e-p2);
  }
  .nav__brand { opacity: 1; }
  .nav__brand:hover .nav__mark { opacity: 0.78; }

  .nav__wordmark {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Set clear of the artwork rather than run into it — the kit asks for at
     least the height of the green core as clear space on every side. */
  .nav__parent { color: var(--w-45); padding-left: 2px; }

  /* The one live line the cinematic chrome always carries, restated. */
  .nav__status {
    flex: 0 1 auto;
    display: none;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    padding-left: var(--s-5);
    border-left: 1px solid var(--w-10);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--w-45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* The continuous half of the condense: the live line thins out as the bar
       closes, on the damped scalar rather than on a class. */
    opacity: calc(1 - 0.7 * var(--nav-condense, 0));
  }
  .nav__dot {
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-signal) 16%, transparent);
  }

  
  

  
  

  
  
  
  
  
  

  
  
  
  

  /* Scroll position, drawn the way the stage ruler draws it. */
  .nav__progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--c-signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (min-width: 1080px) {
    .nav__status { display: flex; }
  }

  /* One row at every width now that there is no strip to wrap. */
  @media (max-width: 760px) {
    .nav__inner { gap: var(--s-3); }
  }

  @media (max-width: 400px) {
    .nav__parent { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__inner { transition: none; }
  }

  /* Touch targets. Placed last deliberately: an equal-specificity rule
     earlier in this file sets the resting padding, and source order decides.
     Line box is 16.5px, so 14px each side is what actually clears 44px. */
  @media (pointer: coarse), (max-width: 760px) {
    .nav__brand { padding-block: 9px; }
  }
</style>
