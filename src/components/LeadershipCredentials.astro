---
import credentials from '../data/yasir-credentials.json';

const artwork = [
  {verificationUrl: 'https://www.credly.com/badges/ac5c0dde-b70a-4339-a8ea-261a785b69e8', src: '/assets/credentials/yasir-nvidia-ai-infrastructure.png'},
  {verificationUrl: 'https://www.credly.com/badges/9a4e2ec5-e3e2-41b0-852b-20ff1f2ca8b7', src: '/assets/credentials/yasir-google-cloud-architect.png'},
];
const featured = artwork.map(asset => ({...credentials.certifications.find(badge => badge.verificationUrl === asset.verificationUrl)!, ...asset}));
const expiry = (date: string) => new Intl.DateTimeFormat('en-US', {month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'}).format(new Date(date));
---
<aside class="leadership-credentials" aria-label="Yasir Jahangir's featured certifications">
  <div class="leadership-credentials-heading">
    <div><p class="credential-eyebrow">Featured CTO credentials</p><h3>{credentials.holder}</h3><p class="credential-role">Chief Technology Officer</p></div>
    <p class="credential-context">AI infrastructure.<br/>Cloud architecture.</p>
  </div>
  <div class="leadership-credentials-grid">
    {featured.map(badge => <a class="leadership-badge" href={badge.verificationUrl} target="_blank" rel="noopener noreferrer" aria-label={`Verify ${credentials.holder}'s ${badge.title} on Credly (opens in a new tab)`}>
      <span class="leadership-badge-art"><img src={badge.src} width="512" height="512" alt={`${badge.title} — official ${badge.issuer} certification badge`} loading="lazy" decoding="async"/></span>
      <span class="leadership-badge-copy"><span class="credential-issuer">{badge.issuer}</span><strong>{badge.title}</strong><span class="credential-expiry">Expires {expiry(badge.expiresAt)}</span><span class="credential-verify">Verify on Credly <span aria-hidden="true">↗</span></span></span>
    </a>)}
  </div>
</aside>
<style>
  .leadership-credentials{margin:0 0 24px;padding:28px;border:1px solid #b3e4c138;border-radius:24px;background:linear-gradient(125deg,#204e38,#103226 70%);color:#eef7ef;font-family:var(--f-sans);min-width:0}
  .leadership-credentials-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin:0 0 24px}
  .leadership-credentials .credential-eyebrow{margin:0 0 12px;color:#a4e6b5;font:11px/1.5 var(--f-mono);letter-spacing:.12em;text-transform:uppercase}
  .leadership-credentials h3{margin:0;font-size:28px;font-weight:500;line-height:1.15;letter-spacing:-.025em;color:#eef7ef}
  .leadership-credentials .credential-role{margin:9px 0 0;color:#bad3c3;font-size:14px;line-height:1.5}
  .leadership-credentials .credential-context{margin:0;color:#b4d5bf;text-align:right;font-size:15px;line-height:1.6}
  .leadership-credentials-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .leadership-credentials .leadership-badge{display:flex;align-items:center;gap:22px;min-width:0;padding:20px;border:1px solid #c6eed13d;border-radius:16px;background:#09281fd9;text-decoration:none;color:inherit;transition:border-color .2s ease,background-color .2s ease}
  .leadership-credentials .leadership-badge:hover{background:#12392b;border-color:#b4edc0a6}
  .leadership-badge:focus-visible{outline:2px solid #b5f6c4;outline-offset:5px}
  .leadership-badge-art{display:grid;place-items:center;flex:0 0 152px;padding:14px;background:#fff;border-radius:12px}
  .leadership-badge-art img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;max-width:512px;filter:none;mix-blend-mode:normal;opacity:1}
  .leadership-badge-copy{display:flex;flex-direction:column;align-items:flex-start;min-width:0;gap:9px}
  .credential-issuer{color:#b4d5bf;font-size:12px;line-height:1.4}
  .leadership-badge-copy strong{font-size:17px;font-weight:500;line-height:1.45;color:#eef7ef;overflow-wrap:anywhere}
  .credential-expiry{color:#bad3c3;font-size:12px;line-height:1.5}
  .credential-verify{display:flex;gap:9px;align-items:center;margin-top:5px;color:#a9f1b9;font-size:13px;line-height:1.5;text-decoration:underline;text-underline-offset:4px}
  @media(max-width:1100px){.leadership-credentials .leadership-badge{flex-direction:column;align-items:flex-start}.leadership-badge-art{flex-basis:auto;width:152px}.leadership-badge-copy{flex:1}.credential-verify{margin-top:auto;padding-top:5px}}
  @media(max-width:620px){.leadership-credentials{padding:20px;border-radius:20px}.leadership-credentials-heading{display:block}.leadership-credentials .credential-context{display:none}.leadership-credentials-grid{grid-template-columns:1fr}.leadership-credentials .leadership-badge{flex-direction:row;align-items:center;gap:16px;padding:16px}.leadership-badge-art{flex:0 0 112px;width:112px;padding:10px}.leadership-badge-copy strong{font-size:15px}.credential-issuer,.credential-expiry{font-size:11px}.credential-verify{font-size:12px}}
  @media(max-width:370px){.leadership-credentials .leadership-badge{flex-direction:column;align-items:flex-start}.leadership-badge-art{flex-basis:auto;width:136px}}
  @media(prefers-reduced-motion:reduce){.leadership-badge{transition:none}}
</style>
