---
import {stages} from '../../data/site';
---
<aside class="journey-cue" data-journey-cue hidden aria-label="Explore the SmartTec story">
  <div class="journey-cue__copy"><span class="journey-cue__instruction" data-journey-instruction>Scroll to explore</span><span class="journey-cue__chapter" data-journey-chapter>01 / 05 · {stages[0].kicker}</span></div>
  <button class="journey-cue__next" type="button" data-journey-next aria-label="Go to the next chapter"><span aria-hidden="true">↓</span></button>
  <div class="journey-cue__track" role="progressbar" aria-label="Story progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-journey-progress><span></span></div>
</aside>
<style>
.journey-cue{position:fixed;z-index:25;bottom:110px;left:50%;transform:translateX(-50%);width:min(420px,calc(100vw - 44px));display:flex;align-items:center;justify-content:space-between;gap:18px;padding:13px 16px 15px 20px;background:#071d15ed;color:#eef1ef;border:1px solid #ace1bc60;border-radius:12px;box-shadow:0 10px 35px #00180d50;backdrop-filter:blur(12px);pointer-events:auto}
.journey-cue__copy{display:grid;gap:6px;min-width:0}.journey-cue__instruction{font:500 14px/1.3 var(--f-sans);color:#bcfac7}.journey-cue__chapter{font:9px/1.5 var(--f-mono);color:#b6cfc0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.journey-cue__next{flex-shrink:0;border:1px solid #b9f1c645;border-radius:50%;width:44px;height:44px;background:#7be88a;color:#10251c;font-size:22px;cursor:pointer}.journey-cue__next:hover{background:#b9fac4}.journey-cue__next:focus-visible{outline:2px solid white;outline-offset:4px}.journey-cue__track{position:absolute;bottom:0;left:16px;right:16px;height:2px;background:#93caaa22;overflow:hidden}.journey-cue__track>span{display:block;width:100%;height:100%;background:#7be88a;transform:scaleX(var(--journey-progress,0));transform-origin:left;transition:transform .12s linear}.journey-cue[data-nudge=true] .journey-cue__next span{display:inline-block;animation:journey-nudge 1.6s ease-in-out 2}
@keyframes journey-nudge{0%,100%{transform:translateY(-2px)}50%{transform:translateY(4px)}}
@media(max-width:700px){.journey-cue{bottom:100px;padding:11px 12px 13px 16px}.journey-cue__instruction{font-size:13px}.journey-cue__chapter{font-size:8px}}
@media(prefers-reduced-motion:reduce){.journey-cue *{animation:none!important;transition:none!important}}
</style>
