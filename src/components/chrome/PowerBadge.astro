---
import { publicDeployment as deployment } from '../../data/site';
---
<a class="power-badge" href="/compute" aria-label={`Explore the proposed ${deployment.gpus}-GPU B300 deployment`}><span>{deployment.gpus} B300</span><span class="power-badge__qual">proposed</span></a>

<style>
.power-badge { font-size: 11px; letter-spacing: 0; white-space: nowrap; text-decoration: none; padding-inline: 8px; gap: 6px; }
.power-badge__qual { opacity: .8; }
</style>
