---
// The reference gamifies progress with an XP counter. Ours counts the thing a
// colocation buyer actually cares about: how much of Phase 1A is committed.
//
// boot.ts writes a plain integer into #power-value. That element stays the
// single source of truth — the script below only watches it, and mirrors it
// into an odometer that rolls the way a real counter does: the ones digit
// spins, the tens only turn as the ones carries.
//
// The number changes every frame while a hold is running, so the visible
// digits are aria-hidden and a separate polite region announces the settled
// value once, 600ms after the last change.
//
// Styles live in src/styles/chrome.css.
---
<div class="power-badge">
  <span class="power-badge__bolt" aria-hidden="true">
    <svg viewBox="0 0 12 16" width="11" height="14" fill="currentColor"><path d="M7 0 0 9h4l-1 7 8-10H7l1-6Z"/></svg>
  </span>

  <!-- The data node boot.ts writes to. Hidden from view once the odometer runs. -->
  <span class="power-badge__value" id="power-value" aria-hidden="true">0</span>
  <span class="power-badge__odo" aria-hidden="true"></span>
  <span class="power-badge__unit" aria-hidden="true">kW</span>

  <span class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"
    >0 kilowatts of Phase 1A capacity committed</span
  >
</div>

<script>
  const badge = document.querySelector<HTMLElement>('.power-badge');
  const source = document.querySelector<HTMLElement>('#power-value');
  const odo = badge?.querySelector<HTMLElement>('.power-badge__odo');
  const announce = badge?.querySelector<HTMLElement>('[role="status"]');

  if (badge && source && odo && announce) {
    // Locals so the null-narrowing above survives into the hoisted helpers.
    const odoEl: HTMLElement = odo;
    const srcEl: HTMLElement = source;
    const liveEl: HTMLElement = announce;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const columns: HTMLElement[] = [];

    badge.dataset.odo = 'on';

    /** One 0-9-0 reel; the trailing zero makes the 9-to-0 carry continuous. */
    function makeColumn(animate: boolean): HTMLElement {
      const col = document.createElement('span');
      col.className = 'odo-col';
      const reel = document.createElement('span');
      reel.className = 'odo-reel';
      for (let d = 0; d <= 10; d += 1) {
        const cell = document.createElement('span');
        cell.textContent = String(d % 10);
        reel.appendChild(cell);
      }
      col.appendChild(reel);
      if (animate && !reduced) {
        col.classList.add('is-new');
        col.addEventListener('animationend', () => col.classList.remove('is-new'), { once: true });
      }
      return col;
    }

    function fitColumns(count: number, animate: boolean): void {
      while (columns.length > count) columns.pop()?.remove();
      while (columns.length < count) {
        const col = makeColumn(animate);
        // A new digit arrives at the most significant end.
        odoEl.insertBefore(col, odoEl.firstChild);
        columns.unshift(col);
      }
    }

    /** Paint `value` — a real number, possibly mid-tween — across the reels. */
    function paint(value: number, animate: boolean): void {
      const v = Math.max(0, value);
      const digits = Math.max(1, String(Math.floor(v)).length);
      fitColumns(digits, animate);

      for (let k = 0; k < digits; k += 1) {
        const place = 10 ** (digits - 1 - k);
        const digit = Math.floor(v / place) % 10;
        const frac = (v / place) % 1;
        // Carry a column over only in the last tenth of the digit below it, so
        // a resting number sits square on its digit instead of half-rolled.
        const carry = frac > 0.9 ? (frac - 0.9) * 10 : 0;
        const reel = columns[k]?.firstElementChild;
        if (reel instanceof HTMLElement) {
          reel.style.setProperty('--o', (digit + carry).toFixed(3));
        }
      }
    }

    // --- count-up ---------------------------------------------------------
    // The reels chase the live value rather than being set to it, and they
    // chase it in seconds: `shown += diff * 0.14` closed 14% of the gap per
    // *frame*, so on a 120Hz display the same top-up landed in half the time.
    // `1 - exp(-dt / tc)` closes the same fraction per second instead. The
    // constant is the reference's own camera-rig smoothing time, 0.12s, which
    // is within a hair of what the old per-frame figure worked out to at 60Hz.
    const SMOOTH_TC = 0.12;

    let shown = 0;
    let target = 0;
    let raf = 0;
    let lastFrame = 0;

    function run(frame: number): void {
      // Clamped so a backgrounded tab does not resume on one enormous step.
      const dt = lastFrame ? Math.min(0.064, (frame - lastFrame) / 1000) : 1 / 60;
      lastFrame = frame;

      raf = 0;
      const diff = target - shown;
      if (Math.abs(diff) < 0.01) {
        shown = target;
        lastFrame = 0;
        paint(shown, true);
        return;
      }
      shown += diff * (1 - Math.exp(-dt / SMOOTH_TC));
      paint(shown, true);
      raf = requestAnimationFrame(run);
    }

    // --- announcement, debounced until the number settles ------------------
    let settle = 0;
    function scheduleAnnounce(): void {
      window.clearTimeout(settle);
      settle = window.setTimeout(() => {
        liveEl.textContent =
          `${Math.round(target)} kilowatts of Phase 1A capacity committed`;
      }, 600);
    }

    function sync(): void {
      const next = Number.parseFloat(srcEl.textContent ?? '0');
      if (!Number.isFinite(next) || next === target) return;
      target = next;
      scheduleAnnounce();
      if (reduced) {
        shown = target;
        paint(shown, false);
        return;
      }
      if (!raf) raf = requestAnimationFrame(run);
    }

    new MutationObserver(sync).observe(srcEl, {
      childList: true,
      characterData: true,
      subtree: true,
    });

    paint(0, false);
    sync();
  }
</script>
