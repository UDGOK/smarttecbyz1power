---
import { stages } from '../../data/site';

/**
 * Scroll ruler — 300x60, pinned top-centre.
 *
 * boot.ts owns `.scroll-ruler-track`'s transform (62px per stage), so the
 * geometry below is built to match: eight ticks + seven 7px gaps + 5px of
 * padding is exactly 62px, which puts a major tick under the indicator at
 * every stage boundary. Three pad segments either side keep the rail full
 * at both ends of the journey.
 *
 * Hover (or keyboard focus) trades the tick rail for jump-to-stage buttons.
 * Styles live in src/styles/chrome.css.
 */

const TICKS_PER_SEGMENT = 8;
const PAD_SEGMENTS = 3;
const ticks = Array.from({ length: TICKS_PER_SEGMENT });
const pads = Array.from({ length: PAD_SEGMENTS });
---
<div class="scroll-ruler" role="group" aria-label="Scroll position and stage navigation">
  <div class="scroll-ruler-rail" aria-hidden="true">
    <div class="scroll-ruler-track">
      {pads.map(() => (
        <div class="ruler-segment ruler-segment--pad">
          {ticks.map((_, i) => <span class={`ruler-tick ${i === 0 ? 'major' : 'minor'}`} />)}
        </div>
      ))}
      {stages.map((s) => (
        <div class="ruler-segment" data-stage={s.id}>
          {ticks.map((_, i) => <span class={`ruler-tick ${i === 0 ? 'major' : 'minor'}`} />)}
        </div>
      ))}
      {pads.map(() => (
        <div class="ruler-segment ruler-segment--pad">
          {ticks.map((_, i) => <span class={`ruler-tick ${i === 0 ? 'major' : 'minor'}`} />)}
        </div>
      ))}
    </div>
  </div>

  <div class="scroll-ruler-indicator" aria-hidden="true"></div>

  <output class="scroll-ruler-readout mono-label" id="ruler-readout" aria-live="polite">{stages[0].ruler}</output>

  <nav class="scroll-ruler-nav" aria-label="Jump to stage">
    {stages.map((s, i) => (
      <button
        type="button"
        class="scroll-ruler-nav-btn"
        data-goto={s.id}
        data-cursor="action"
        aria-current="false"
        aria-label={`Jump to stage ${i + 1} of ${stages.length} — ${s.kicker}`}
        style={`--i: ${i}`}
      >
        <span class="scroll-ruler-nav-line" aria-hidden="true"></span>
        <span class="scroll-ruler-nav-label">{s.ruler}</span>
      </button>
    ))}
  </nav>
</div>

<script>
  /**
   * Velocity readout for the indicator.
   *
   * boot.ts already writes the track's translateX once per scroll frame, so
   * the cheapest honest source of scroll speed is the delta on that inline
   * transform — no second scroll listener, no layout read. The value lands on
   * --v, which chrome.css uses to stretch the indicator and bloom its smear.
   */
  const ruler = document.querySelector<HTMLElement>('.scroll-ruler');
  const track = document.querySelector<HTMLElement>('.scroll-ruler-track');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (ruler && track && !reduced) {
    const readX = (): number => {
      const m = /-?[\d.]+/.exec(track.style.transform);
      return m ? parseFloat(m[0]) : 0;
    };

    let last = readX();
    let v = 0;
    let written = '';

    const tick = (): void => {
      const now = readX();
      const delta = Math.abs(now - last);
      last = now;

      // ~6px of track in one frame is a hard flick.
      const target = Math.min(1, delta / 6);
      // Rise fast, fall slow: the smear should trail the movement, not lead it.
      v += (target - v) * (target > v ? 0.55 : 0.11);
      if (v < 0.004) v = 0;

      const out = v.toFixed(3);
      if (out !== written) {
        written = out;
        ruler.style.setProperty('--v', out);
      }
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  }
</script>
