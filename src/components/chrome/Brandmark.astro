---
import { company } from '../../data/site';
import { SYMBOL_VIEWBOX, SYMBOL_LETTER, SYMBOL_CORE } from '../../data/logo';

/**
 * Brandmark, top-left — the SmartTec symbol.
 *
 * The dashed orbit and stroked glyph that used to live here were a stand-in
 * drawn before there was a logo. There is one now, so the stand-in is gone
 * rather than wrapped around the real mark: the kit is explicit that the
 * letterforms stay flat and their proportions stay locked, and a rotating ring
 * reads as part of the mark to anyone who has not seen the brand sheet.
 *
 * What survives is the hover ping — a ring that expands once and fades, drawn
 * outside the mark's clear space, which is interaction feedback rather than
 * decoration applied to the logo.
 *
 * The letterform rides currentColor so it inverts with the stage chrome; the
 * core holds brand green in both. Styles live in src/styles/chrome.css.
 */
---
<a class="brandmark" href="/" aria-label={`${company.full} — home`} data-cursor="action">
  <span class="brandmark__ping" aria-hidden="true"></span>
  <svg class="brandmark__svg" viewBox={SYMBOL_VIEWBOX} width="25" height="26" aria-hidden="true" fill-rule="evenodd">
    <path class="brandmark__letter" d={SYMBOL_LETTER} />
    <path class="brandmark__core" d={SYMBOL_CORE} />
  </svg>
</a>
