---
import { company } from '../../data/site';

/**
 * Brandmark, top-left.
 *
 * Alive without being noisy: a dashed orbit turning once every 34 seconds
 * behind a static rim, and a signal pip on the rim that breathes — the site
 * is on. Hover speeds the orbit, tips the glyph and sends one ping outward.
 * All of it transform/opacity, all of it off under reduced motion.
 *
 * Styles live in src/styles/chrome.css.
 */
---
<a class="brandmark" href="/" aria-label={`${company.full} — home`} data-cursor="action">
  <span class="brandmark__ping" aria-hidden="true"></span>
  <svg class="brandmark__svg" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
    <circle class="brandmark__rim" cx="20" cy="20" r="19" />
    <circle class="brandmark__orbit" cx="20" cy="20" r="19" />
    <path
      class="brandmark__glyph"
      d="M12 14h16l-11 12h11"
    />
    <circle class="brandmark__pip" cx="33.4" cy="33.4" r="2" />
  </svg>
</a>
