---
// Floating capture bar, pinned bottom-centre like the reference's beta bar.
import { FORM_ACTION } from '../../data/contact';
//
// This is the only always-light element on a site whose scene is usually dark,
// so it rests at 0.9 behind a wide soft shadow and comes to full strength the
// moment you touch it — and on the white campus stage it picks up a hairline,
// or it would dissolve into the daylight.
//
// boot.ts owns submit (validation + the message). The script below only
// mirrors that into visual state, so the two never fight.
//
// Styles live in src/styles/chrome.css.
---
<form class="cta-bar" id="reserve-form" method="post" action={FORM_ACTION}>
  <input type="hidden" name="_subject" value="SmartTec deployment inquiry" />
  <input type="hidden" name="source" value="capture-bar" />
  <button type="button" class="cta-bar__back" aria-label="Previous stage" data-back data-cursor="action">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
  </button>

  <label class="visually-hidden" for="reserve-email">Work email</label>
  <span class="cta-bar__field">
    <input
      class="cta-bar__input"
      id="reserve-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="work email"
      aria-describedby="reserve-msg"
      required
    />
    <span class="cta-bar__rule" aria-hidden="true"></span>
  </span>

  <button type="submit" class="cta-bar__submit" data-cursor="action">
    <span class="cta-bar__submit-label">Get in touch</span>
    <span class="cta-bar__spinner" aria-hidden="true"></span>
  </button>

  <p class="cta-bar__msg mono-label" id="reserve-msg" role="status"></p>
</form>

<script>
  // boot.ts owns submit, validation, delivery and every state class on this
  // form. The only thing left here is clearing a stale state when the visitor
  // starts typing again.
  //
  // What used to be here was a 620 ms timer that added `is-sent` regardless of
  // whether anything had been sent. It has no replacement: the "sent" state is
  // now written by boot.ts, and only when a server has acknowledged the post.
  const bar = document.querySelector<HTMLFormElement>('#reserve-form');
  const input = document.querySelector<HTMLInputElement>('#reserve-email');
  const msg = document.querySelector<HTMLElement>('#reserve-msg');

  if (bar && input && msg) {
    input.addEventListener('input', () => {
      if (bar.classList.contains('is-error') && input.value.includes('@')) {
        bar.classList.remove('is-error');
        msg.textContent = '';
      }
      if (bar.classList.contains('is-sent')) {
        bar.classList.remove('is-sent');
        msg.textContent = '';
      }
    });
  }
</script>
