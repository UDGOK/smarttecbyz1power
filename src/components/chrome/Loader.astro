---
import { company } from '../../data/site';

/**
 * Entry card.
 *
 * The company's own logo, with the brand's electron flow running through it,
 * over the live world. Every visitor sees this before anything else, which is
 * the point — it is the one screen where the mark gets to be the subject
 * rather than a 25px corner glyph.
 *
 * Three layers, in order of how certainly they appear:
 *
 *   1. The lockup as a vector <img>. Present at first paint, no script, no
 *      raster decode. This is what a visitor sees if everything else fails.
 *   2. The particle canvas, mounted on top and cross-faded in only once it is
 *      actually running. It starts from the readable logo rather than
 *      gathering into it — the card only dwells ~2.3s, and a half-formed
 *      wordmark in that window reads as a broken image, not as an animation.
 *   3. The line and rule underneath, unchanged.
 *
 * Transparent mode, which the kit documents for exactly this case: particles
 * over an existing scene, with the container's own forest fill turned off so
 * the world still reads through the card.
 */
---
<div class="intro" id="loader" role="status" aria-live="polite">
  <div class="intro__stage">
    <div class="intro__logo" id="loader-logo">
      <img
        class="intro__logo-flat"
        src="/assets/brand/smarttec-lockup-offwhite-green.svg"
        alt={company.full}
        width="1231"
        height="298"
        fetchpriority="high"
        decoding="async"
      />
      <div
        class="intro__logo-live smarttec-particle-stage"
        id="loader-particles"
        data-transparent
        aria-hidden="true"
      ></div>
    </div>

    <p class="intro__sub mono-label" id="loader-sub">
      <span class="intro__mask intro__mask--sub"><span class="intro__word">Neo compute and colocation</span></span>
    </p>
    <span class="intro__rule" aria-hidden="true"></span>
  </div>

  <button type="button" class="intro__skip mono-label" id="loader-skip">Enter</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: center;
    /* Transparent over the world, as the reference's own gate is — only a
       vignette, so the scene reads through it from the first frame. */
    background: radial-gradient(120% 90% at 50% 50%, transparent 24%, var(--k-30) 70%, var(--k-55) 100%);
    transition: opacity 0.9s var(--e-out), visibility 0.9s;
  }
  .intro.is-done { opacity: 0; visibility: hidden; pointer-events: none; }
  .intro[hidden] { display: none; }

  .intro__stage { display: grid; justify-items: center; gap: var(--s-4); padding: var(--s-5); }

  /* One box, two stacked layers. Sized by width with the aspect held open so
     nothing reflows when the canvas arrives. The renderer fits the logo to 84%
     of the box and centres it at 47% height, so the box is deliberately taller
     than the artwork — that headroom is where the electrons travel. */
  .intro__logo {
    position: relative;
    display: grid;
    width: min(78vw, 720px);
    aspect-ratio: 1231 / 430;
  }
  .intro__logo-flat,
  .intro__logo-live {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }
  .intro__logo-flat {
    align-self: center;
    height: auto;
    /* The flat mark rises like the line it replaced. */
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s var(--e-p2), transform 0.75s var(--e-osmo);
  }
  .intro.is-in .intro__logo-flat { opacity: 1; transform: none; }

  .intro__logo-live {
    opacity: 0;
    transition: opacity 0.7s var(--e-p2);
  }
  /* Set only when the renderer is genuinely running. Until then the flat mark
     is the one on screen, and if mounting fails it stays that way. */
  .intro__logo.is-live .intro__logo-live { opacity: 1; }
  .intro__logo.is-live .intro__logo-flat { opacity: 0; }

  .intro__sub { color: var(--w-55); letter-spacing: 0.24em; }

  /* Each word rises out of its own mask. */
  .intro__mask { display: inline-block; overflow: hidden; vertical-align: bottom; }
  .intro__mask--sub { overflow: hidden; }
  .intro__word {
    display: inline-block;
    transform: translateY(115%);
    opacity: 0;
  }
  .intro.is-in .intro__word {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.75s var(--e-osmo), opacity 0.5s var(--e-p2);
  }
  .intro.is-in .intro__sub .intro__word { transition-delay: 0.24s; }

  .intro__rule {
    width: 0;
    height: 1px;
    background: var(--w-30);
    transition: width 0.9s var(--e-osmo) 0.34s;
  }
  .intro.is-in .intro__rule { width: min(46vw, 420px); }

  .intro__skip {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    padding: 11px 22px;
    border: 1px solid var(--chrome-hairline);
    border-radius: var(--r-pill);
    background: none;
    color: var(--w-45);
    cursor: pointer;
    opacity: 0;
    /* Not clickable or focusable until it can actually be seen. */
    pointer-events: none;
    transition: opacity var(--d-mid) var(--e-p2), color var(--d-quick) var(--e-p2),
                border-color var(--d-quick) var(--e-p2);
  }
  .intro.is-ready .intro__skip { opacity: 1; pointer-events: auto; }
  .intro__skip:hover { color: var(--w-90); border-color: var(--w-30); }

  @media (prefers-reduced-motion: reduce) {
    .intro__word { transform: none; opacity: 1; }
    .intro__logo-flat { transform: none; }
    .intro__rule { width: min(46vw, 420px); transition: none; }
    /* The vignette is transparent in the middle so the world reads through the
       card. That only works because the stage copy behind it is still hidden —
       and under reduced motion it deliberately never is, since nothing is
       going to animate it back. So the first headline showed straight through
       the entry card, one set of words on top of another. Opaque here, and
       only here. */
    .intro { background: var(--c-land-deep); }
  }
</style>
