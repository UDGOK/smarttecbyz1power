---
// Entry gate. The reference makes you draw a zero before it lets you in; ours
// makes you close the circuit. Same idea: a gesture, not a button, and the
// gesture is the brand.
---
<div class="loader" id="loader" role="dialog" aria-modal="true" aria-labelledby="loader-title">
  <div class="loader__stage">
    <svg class="loader__ring" viewBox="0 0 240 240" aria-hidden="true">
      <circle class="loader__ring-track" cx="120" cy="120" r="96" />
      <circle class="loader__ring-arc" cx="120" cy="120" r="96" />
      <circle class="loader__ring-head" cx="120" cy="24" r="6" />
    </svg>
    <p class="loader__label mono-label" id="loader-title">Close the circuit</p>
    <p class="loader__sub mono-label" id="loader-sub">Loading site 01</p>
  </div>

  <button type="button" class="loader__skip mono-label" id="loader-skip">
    Enter without the gesture
  </button>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: center;
    background: #0a1a14;
    touch-action: none;
    cursor: none;
    transition: opacity 0.9s var(--e-out), visibility 0.9s;
  }
  .loader.is-done { opacity: 0; visibility: hidden; pointer-events: none; }

  .loader__stage { position: relative; display: grid; place-items: center; }

  .loader__ring { width: min(58vmin, 320px); height: min(58vmin, 320px); overflow: visible; }
  .loader__ring-track {
    fill: none;
    stroke: var(--w-10);
    stroke-width: 1;
  }
  .loader__ring-arc {
    fill: none;
    stroke: var(--w-85);
    stroke-width: 2;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 120px 120px;
    filter: drop-shadow(0 0 10px #ffffff55);
  }
  .loader__ring-head {
    fill: var(--c-white);
    filter: drop-shadow(0 0 12px #ffffffaa);
    transition: opacity var(--d-base);
  }

  .loader__label {
    position: absolute;
    color: var(--w-90);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-align: center;
    pointer-events: none;
    transition: opacity var(--d-base);
  }
  .loader__sub {
    position: absolute;
    top: calc(50% + 26px);
    color: var(--w-30);
    font-size: 10px;
    letter-spacing: 0.18em;
    pointer-events: none;
  }
  .loader.is-ready .loader__sub { opacity: 0; }
  .loader.is-drawing .loader__label { opacity: 0.25; }

  .loader__skip {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    padding: 9px 18px;
    border: 1px solid var(--w-10);
    border-radius: var(--r-pill);
    background: none;
    color: var(--w-45);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--d-base), color var(--d-fast), border-color var(--d-fast);
  }
  .loader.is-ready .loader__skip { opacity: 1; }
  .loader__skip:hover { color: var(--w-90); border-color: var(--w-30); }
</style>
