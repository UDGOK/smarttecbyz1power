---
// Entry gate. The reference makes you draw a zero before it lets you in; ours
// makes you close the circuit. Same idea: a gesture, not a button, and the
// gesture is the brand.
//
// The gate is a *transparent* overlay — the live WebGL scene keeps running
// behind it, and the only thing between the visitor and the world is a soft
// vignette that keeps the prompt legible. Everything the pointer draws lands on
// the <canvas> below, painted in src/lib/loader.ts.
---
<div class="loader" id="loader" role="dialog" aria-modal="true" aria-labelledby="loader-title">
  <canvas class="loader__ink" aria-hidden="true"></canvas>

  <div class="loader__stage">
    <p class="loader__label mono-label" id="loader-title">Close the circuit</p>
    <p class="loader__sub mono-label" id="loader-sub">Loading site 01</p>
  </div>

  <button type="button" class="loader__skip mono-label" id="loader-skip">
    Enter without the gesture
  </button>
</div>

<style>
  .loader {
    /* Ink colours, named once here so the canvas can read them back off the
       element rather than hard-coding anything. */
    --ink-core: var(--c-white);
    --ink-glow: var(--c-signal);

    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: center;
    /* No ground of its own: just enough fall-off at the edges to hold the
       prompt against whatever the scene happens to be doing. */
    background: radial-gradient(
      120% 90% at 50% 50%,
      transparent 28%,
      var(--k-30) 72%,
      var(--k-55) 100%
    );
    touch-action: none;
    cursor: none;
    /* A drag across the viewport must draw, not select the prompt. */
    -webkit-user-select: none;
    user-select: none;
    transition: opacity 0.9s var(--e-out), visibility 0.9s;
  }
  .loader.is-done { opacity: 0; visibility: hidden; pointer-events: none; }

  /* The drawing surface. Pointer events stay on .loader so the whole viewport
     is drawable; the canvas is purely a paint layer. */
  .loader__ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    touch-action: none;
  }

  .loader__stage {
    position: relative;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .loader__label {
    color: var(--w-90);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-align: center;
    text-shadow: 0 1px 14px var(--k-70);
    transition: opacity var(--d-base);
  }
  .loader__sub {
    position: absolute;
    top: calc(100% + 14px);
    color: var(--w-30);
    font-size: 10px;
    letter-spacing: 0.18em;
    white-space: nowrap;
    transition: opacity var(--d-base);
  }
  .loader.is-ready .loader__sub { opacity: 0; }
  /* Once the pointer is down the stroke is the whole message. */
  .loader.is-drawing .loader__label { opacity: 0.45; }

  .loader__skip {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    padding: 9px 18px;
    border: 1px solid var(--w-10);
    border-radius: var(--r-pill);
    background: none;
    color: var(--w-45);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--d-base), color var(--d-fast), border-color var(--d-fast);
  }
  .loader.is-ready .loader__skip { opacity: 1; }
  .loader__skip:hover { color: var(--w-90); border-color: var(--w-30); }
  .loader__skip:focus-visible { color: var(--w-90); border-color: var(--w-45); }
</style>
