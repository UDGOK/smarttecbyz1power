---
import { company } from '../../data/site';
---
<div class="intro" id="loader" role="status" aria-live="polite">
  <div class="intro__stage">
    <p class="intro__line" id="loader-title">
      <span class="intro__mask"><span class="intro__word silver">SmartTec</span></span>
      <span class="intro__mask"><span class="intro__word intro__word--by">by {company.parent}</span></span>
    </p>
    <p class="intro__sub mono-label" id="loader-sub">
      <span class="intro__mask intro__mask--sub"><span class="intro__word">Neo compute and colocation</span></span>
    </p>
    <span class="intro__rule" aria-hidden="true"></span>
  </div>

  <button type="button" class="intro__skip mono-label" id="loader-skip">Enter</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: center;
    /* Transparent over the world, as the reference's own gate is — only a
       vignette, so the scene reads through it from the first frame. */
    background: radial-gradient(120% 90% at 50% 50%, transparent 24%, var(--k-30) 70%, var(--k-55) 100%);
    transition: opacity 0.9s var(--e-out), visibility 0.9s;
  }
  .intro.is-done { opacity: 0; visibility: hidden; pointer-events: none; }
  .intro[hidden] { display: none; }

  .intro__stage { display: grid; justify-items: center; gap: var(--s-4); padding: var(--s-5); }

  .intro__line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.28em;
    margin: 0;
    font-family: var(--f-display);
    font-weight: var(--fw-display);
    font-size: clamp(2.4rem, 1rem + 6.2vw, 6.4rem);
    line-height: 0.94;
    letter-spacing: var(--ls-display);
    color: var(--w-95);
    text-align: center;
  }
  .intro__word--by {
    /* The parent name sits back so the product name carries the line. */
    font-size: 0.42em;
    align-self: end;
    padding-bottom: 0.34em;
    color: var(--w-45);
    letter-spacing: 0.02em;
  }

  .intro__sub { color: var(--w-55); letter-spacing: 0.24em; }

  /* Each word rises out of its own mask. */
  .intro__mask { display: inline-block; overflow: hidden; vertical-align: bottom; }
  .intro__mask--sub { overflow: hidden; }
  .intro__word {
    display: inline-block;
    transform: translateY(115%);
    opacity: 0;
  }
  .intro.is-in .intro__word {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.75s var(--e-osmo), opacity 0.5s var(--e-p2);
  }
  .intro.is-in .intro__mask:nth-child(2) .intro__word { transition-delay: 0.09s; }
  .intro.is-in .intro__sub .intro__word { transition-delay: 0.24s; }

  .intro__rule {
    width: 0;
    height: 1px;
    background: var(--w-30);
    transition: width 0.9s var(--e-osmo) 0.34s;
  }
  .intro.is-in .intro__rule { width: min(46vw, 420px); }

  .intro__skip {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    padding: 11px 22px;
    border: 1px solid var(--chrome-hairline);
    border-radius: var(--r-pill);
    background: none;
    color: var(--w-45);
    cursor: pointer;
    opacity: 0;
    /* Not clickable or focusable until it can actually be seen. */
    pointer-events: none;
    transition: opacity var(--d-mid) var(--e-p2), color var(--d-quick) var(--e-p2),
                border-color var(--d-quick) var(--e-p2);
  }
  .intro.is-ready .intro__skip { opacity: 1; pointer-events: auto; }
  .intro__skip:hover { color: var(--w-90); border-color: var(--w-30); }

  @media (prefers-reduced-motion: reduce) {
    .intro__word { transform: none; opacity: 1; }
    .intro__rule { width: min(46vw, 420px); transition: none; }
  }
</style>
