---
import { company } from '../../data/site';
import '../../styles/intro.css';
const lanes=Array.from({length:12},(_,i)=>i);
const particles=Array.from({length:19},(_,i)=>({x:500+Math.cos(i*2.4)*Math.sqrt(i)*9,y:300+Math.sin(i*2.4)*Math.sqrt(i)*9}));
---
<section class="intro" id="loader" aria-label="Welcome to SmartTec">
  <div class="intro__world" aria-hidden="true">
    <div class="intro__stars"></div>
    <img class="intro__facility" src="/assets/cinematic/campus-1586.webp" srcset="/assets/cinematic/campus-800.webp 800w, /assets/cinematic/campus-1586.webp 1586w" sizes="100vw" alt="" width="1586" height="992" decoding="async" />
    <div class="intro__facility-shade"></div>
    <svg class="intro__signal" viewBox="0 0 1000 600" fill="none" preserveAspectRatio="xMidYMid slice">
      <defs><radialGradient id="intro-core"><stop stop-color="#f4ffed"/><stop offset=".45" stop-color="#98fba8"/><stop offset="1" stop-color="#2b926d"/></radialGradient></defs>
      <g class="intro__atom">
        <ellipse cx="500" cy="300" rx="148" ry="45"/><ellipse cx="500" cy="300" rx="148" ry="45" transform="rotate(60 500 300)"/><ellipse cx="500" cy="300" rx="148" ry="45" transform="rotate(-60 500 300)"/>
        <g class="intro__nucleus">{particles.map((p,i)=><circle cx={p.x} cy={p.y} r={i%2?12:14} fill={i%2?'#d3e8db':'url(#intro-core)'} />)}</g>
        <circle class="intro__electron" cx="352" cy="300" r="5"/><circle class="intro__electron" cx="574" cy="428" r="4"/>
      </g>
      <g class="intro__fibers">{lanes.map(i=><path style={`--lane:${i}`} pathLength="100" d={`M ${i%2?-80:1080} ${45+i*47} C ${i%2?220:780} ${20+i*49}, ${i%2?360:640} ${300+(i-6)*9}, 500 300`} />)}</g>
      <g class="intro__rack-lines">{[-3,-2,-1,1,2,3].map((n,i)=><g style={`--lane:${i}`}><path d={`M ${500+n*64} 190 L ${500+n*64+36} 200 V 438 L ${500+n*64} 455 Z`} />{[0,1,2,3,4,5,6,7].map(j=><path d={`M ${504+n*64} ${216+j*27} h 24`} />)}</g>)}</g>
    </svg>
  </div>
  <div class="intro__top"><span>SMARTTEC / THE SIGNAL</span><a class="intro__skip" id="loader-skip" href="/site">Skip intro <span aria-hidden="true">↗</span></a></div>
  <div class="intro__identity"><img class="intro__logo-flat" src="/assets/brand/smarttec-lockup-offwhite-green.svg" alt={company.full} width="1231" height="298" fetchpriority="high" decoding="async" /><p>From energy to intelligence.</p></div>
  <div class="intro__story" aria-hidden="true"><span>01 / Energy</span><span>02 / Signal</span><span>03 / Intelligence</span></div>
  <div class="intro__footer"><p class="intro__auto">Entering automatically</p><p class="intro__fallback">Follow the signal. <a href="/site">Enter site ↗</a></p><div class="intro__timeline" aria-hidden="true"><span></span></div><span class="intro__concept">An abstract infrastructure concept</span></div>
</section>
