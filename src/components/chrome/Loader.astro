---
import { company } from '../../data/site';
---
<section class="intro" id="loader" aria-label="Welcome to SmartTec">
  <div class="intro__stage">
    <img class="intro__logo-flat" src="/assets/brand/smarttec-lockup-offwhite-green.svg" alt={company.full} width="1231" height="298" fetchpriority="high" decoding="async" />
    <a class="intro__skip" id="loader-skip" href="/site">Enter <span aria-hidden="true">↗</span></a>
  </div>
</section>
<style>
  .intro{position:fixed;inset:0;z-index:100;display:grid;place-items:center;min-height:100svh;background:radial-gradient(ellipse at 50% 45%,#16392c 0%,#071410 65%);transition:opacity .35s ease,visibility .35s;overflow:auto}
  .intro.is-done{opacity:0;visibility:hidden;pointer-events:none}
  .intro[hidden]{display:none}
  .intro__stage{width:100%;display:grid;justify-items:center;gap:clamp(36px,7vh,72px);padding:48px 24px}
  .intro__logo-flat{display:block;width:min(76vw,640px);height:auto}
  .intro__skip{display:inline-flex;align-items:center;justify-content:center;gap:28px;min-width:146px;min-height:48px;padding:13px 26px;border:1px solid #7be88a88;border-radius:999px;background:#7be88a;color:#10251c;font:14px/1.4 var(--f-mono);text-decoration:none;transition:background .2s,transform .2s}
  .intro__skip:hover{background:#a1f3ac;transform:translateY(-2px)}
  .intro__skip:focus-visible{outline:2px solid #eef1ef;outline-offset:7px}
  @media(prefers-reduced-motion:reduce){.intro,.intro__skip{transition:none}.intro__skip:hover{transform:none}}
</style>
